{
  "apiVersion": 1,
  "root": {
    "id": "studio-root",
    "type": "column",
    "padding": 8,
    "gap": 8,
    "children": [
      {
        "id": "studio-header",
        "type": "row",
        "height": 52,
        "padding": {
          "top": 6,
          "right": 12,
          "bottom": 6,
          "left": 12
        },
        "gap": 8,
        "align": "center",
        "style": "surface.card",
        "children": [
          {
            "id": "studio-brand",
            "type": "component",
            "component": "app.brand.title",
            "grow": 1
          },
          {
            "id": "studio-mode",
            "type": "component",
            "component": "workspace.studio",
            "style": "textButton.primary",
            "width": 112,
            "focusOrder": 1
          },
          {
            "id": "listening-mode",
            "type": "component",
            "component": "workspace.listening",
            "style": "textButton.neutral",
            "width": 112,
            "focusOrder": 2
          },
          {
            "id": "open-settings",
            "type": "component",
            "component": "settings.open",
            "style": "textButton.neutral",
            "width": 88,
            "focusOrder": 3
          }
        ]
      },
      {
        "id": "studio-content",
        "type": "row",
        "gap": 8,
        "grow": 1,
        "children": [
          {
            "id": "studio-library-card",
            "type": "column",
            "width": "42%",
            "padding": 12,
            "gap": 8,
            "style": "surface.card",
            "children": [
              {
                "id": "studio-library-card-preset",
                "type": "row",
                "height": 36,
                "shrink": 0,
                "gap": 8,
                "align": "center",
                "children": [
                  {
                    "id": "studio-library-card-preset-select",
                    "type": "component",
                    "component": "listeningPreset.select",
                    "style": "comboBox.default",
                    "grow": 1,
                    "height": 32,
                    "focusOrder": 4
                  },
                  {
                    "id": "studio-library-card-preset-actions",
                    "type": "component",
                    "component": "listeningPreset.actions",
                    "style": "textButton.default",
                    "width": 92,
                    "height": 32,
                    "shrink": 0,
                    "focusOrder": 5
                  }
                ]
              },
              {
                "id": "studio-library-title-row",
                "type": "row",
                "height": 24,
                "shrink": 0,
                "gap": 8,
                "children": [
                  {
                    "id": "studio-library-title",
                    "type": "component",
                    "component": "library.title",
                    "grow": 1
                  },
                  {
                    "id": "studio-library-count",
                    "type": "component",
                    "component": "library.count",
                    "width": 80
                  }
                ]
              },
              {
                "id": "studio-library-selector-row",
                "type": "row",
                "height": 36,
                "shrink": 0,
                "gap": 8,
                "children": [
                  {
                    "id": "studio-library-collections",
                    "type": "component",
                    "component": "library.collections",
                    "grow": 1,
                    "focusOrder": 6
                  },
                  {
                    "id": "studio-library-add",
                    "type": "component",
                    "component": "library.add",
                    "style": "textButton.primary",
                    "width": 104,
                    "focusOrder": 7
                  }
                ]
              },
              {
                "id": "studio-library-actions-row",
                "type": "row",
                "height": 32,
                "shrink": 0,
                "gap": 8,
                "children": [
                  {
                    "id": "studio-library-search",
                    "type": "component",
                    "component": "library.search",
                    "grow": 1,
                    "focusOrder": 8
                  },
                  {
                    "id": "studio-library-new",
                    "type": "component",
                    "component": "library.newPlaylist",
                    "style": "textButton.neutral",
                    "width": 92,
                    "focusOrder": 9
                  },
                  {
                    "id": "studio-library-actions",
                    "type": "component",
                    "component": "library.actions",
                    "style": "textButton.neutral",
                    "width": 92,
                    "focusOrder": 10
                  }
                ]
              },
              {
                "id": "studio-library-tracks",
                "type": "component",
                "component": "library.tracks",
                "presentation": "table",
                "grow": 1,
                "focusOrder": 11
              },
              {
                "id": "studio-library-empty",
                "type": "component",
                "component": "library.empty",
                "height": 18,
                "shrink": 0
              }
            ]
          },
          {
            "id": "studio-output-panel",
            "type": "column",
            "width": "24%",
            "gap": 8,
            "children": [
              {
                "id": "studio-output-options",
                "type": "row",
                "height": 32,
                "shrink": 0,
                "gap": 4,
                "children": [
                  {
                    "id": "studio-output-mode",
                    "type": "component",
                    "component": "output.mode",
                    "grow": 1,
                    "focusOrder": 12
                  },
                  {
                    "id": "studio-output-reset",
                    "type": "component",
                    "component": "output.reset",
                    "width": 60,
                    "focusOrder": 13
                  }
                ]
              },
              {
                "id": "studio-output-layout",
                "type": "component",
                "component": "effects.outputLayout",
                "height": 32,
                "shrink": 0,
                "focusOrder": 14
              },
              {
                "id": "studio-output-view",
                "type": "stack",
                "grow": 1,
                "children": [
                  {
                    "id": "studio-output",
                    "type": "component",
                    "component": "output.stage",
                    "anchors": {
                      "left": 0,
                      "right": 0,
                      "top": 0,
                      "bottom": 0
                    }
                  },
                  {
                    "id": "studio-output-mixer",
                    "type": "component",
                    "component": "output.mixer",
                    "style": "channelMixer.mixer",
                    "anchors": {
                      "left": 0,
                      "right": 0,
                      "top": 0,
                      "bottom": 0
                    },
                    "focusOrder": 15
                  }
                ]
              }
            ]
          },
          {
            "id": "studio-right-card",
            "type": "column",
            "padding": 12,
            "gap": 8,
            "grow": 1,
            "style": "surface.card",
            "children": [
              {
                "id": "studio-now-title",
                "type": "component",
                "component": "nowPlaying.title",
                "height": 34
              },
              {
                "id": "studio-now-meta",
                "type": "component",
                "component": "nowPlaying.metadata",
                "height": 22
              },
              {
                "id": "studio-seek",
                "type": "component",
                "component": "transport.seek",
                "style": "linearSlider.seek",
                "height": 28,
                "focusOrder": 17
              },
              {
                "id": "studio-time",
                "type": "component",
                "component": "transport.time",
                "height": 20
              },
              {
                "id": "studio-controls",
                "type": "row",
                "height": 44,
                "gap": 8,
                "children": [
                  {
                    "id": "studio-previous",
                    "type": "component",
                    "component": "transport.previous",
                    "style": "textButton.neutral",
                    "focusOrder": 18
                  },
                  {
                    "id": "studio-play",
                    "type": "component",
                    "component": "transport.playPause",
                    "style": "textButton.primary",
                    "focusOrder": 19
                  },
                  {
                    "id": "studio-next",
                    "type": "component",
                    "component": "transport.next",
                    "style": "textButton.neutral",
                    "focusOrder": 20
                  }
                ]
              },
              {
                "id": "studio-volume",
                "type": "component",
                "component": "transport.volume",
                "presentation": "linearHorizontal",
                "height": 32,
                "focusOrder": 21
              },
              {
                "id": "studio-effects-presets",
                "type": "row",
                "height": 36,
                "shrink": 0,
                "gap": 8,
                "align": "center",
                "children": [
                  {
                    "id": "studio-effects-presets-select",
                    "type": "component",
                    "component": "effects.preset.select",
                    "style": "comboBox.default",
                    "height": 32,
                    "grow": 1,
                    "focusOrder": 22
                  },
                  {
                    "id": "studio-effects-presets-actions",
                    "type": "component",
                    "component": "effects.preset.actions",
                    "style": "textButton.default",
                    "height": 32,
                    "width": 92,
                    "shrink": 0,
                    "focusOrder": 23
                  }
                ]
              },
              {
                "id": "studio-effects",
                "type": "component",
                "component": "effects.open",
                "style": "textButton.neutral",
                "width": 112,
                "height": 34,
                "focusOrder": 24
              }
            ]
          }
        ]
      },
      {
        "id": "studio-status",
        "type": "component",
        "component": "app.status",
        "height": 28
      }
    ]
  },
  "ancillaryStyles": {
    "smartPlaylistEditor": "smartPlaylistEditor.default"
  }
}
