                  {
                    "id": "skins-apply-studio",
                    "type": "component",
                    "component": "settings.skins.apply",
                    "style": "textButton.primary",
                    "height": 34,
                    "focusOrder": 110
                  },
                  {
                    "id": "skins-cancel-preview-studio",
                    "type": "component",
                    "component": "settings.skins.cancelPreview",
                    "style": "textButton.neutral",
