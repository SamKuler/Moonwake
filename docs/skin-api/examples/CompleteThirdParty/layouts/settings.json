                  {
                    "id": "audio-buffer-studio",
                    "type": "component",
                    "component": "settings.audio.bufferSize",
                    "height": 34,
                    "focusOrder": 40
                  },
                  {
                    "id": "audio-layout-studio",
                    "type": "component",
                    "component": "settings.audio.channelLayout",
                    "height": 34,
                    "focusOrder": 50
