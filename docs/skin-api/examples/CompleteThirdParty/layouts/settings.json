      },
      "ancillaryStyles": {
        "popupMenu": "popupMenu.studio",
        "tooltip": "tooltip.studio",
        "scrollBar": "scrollBar.studio"
      }
    }
  ],
  "ancillaryStyles": {
    "popupMenu": "popupMenu.default",
    "tooltip": "tooltip.default",
    "scrollBar": "scrollBar.default"
  }
}
