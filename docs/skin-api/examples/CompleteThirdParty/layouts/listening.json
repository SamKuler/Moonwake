                  {
                    "id": "listening-library-empty",
                    "type": "component",
                    "component": "library.empty",
                    "height": 18,
                    "shrink": 0
                  }
                ]
              },
              {
                "id": "listening-transport-card",
                "type": "row",
                "height": 104,
                "padding": 12,
                "gap": 8,
                "align": "center",
                "style": "surface.card",
                "children": [
                  {
                    "id": "listening-previous",
                    "type": "component",
                    "component": "transport.previous",
                    "style": "textButton.neutral",
                    "width": 64,
                    "height": 44,
                    "focusOrder": 260
                  },
                  {
                    "id": "listening-play",
                    "type": "component",
                    "component": "transport.playPause",
                    "style": "textButton.primary",
                    "width": 72,
                    "height": 48,
                    "focusOrder": 270
                  },
                  {
                    "id": "listening-next",
                    "type": "component",
                    "component": "transport.next",
                    "style": "textButton.neutral",
                    "width": 64,
                    "height": 44,
                    "focusOrder": 280
                  },
                  {
                    "id": "listening-effects",
                    "type": "component",
                    "component": "effects.open",
                    "style": "textButton.neutral",
                    "width": 92,
                    "height": 36,
                    "focusOrder": 300
