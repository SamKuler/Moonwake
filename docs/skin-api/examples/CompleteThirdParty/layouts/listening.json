                  {
                    "id": "listening-volume",
                    "type": "component",
                    "component": "transport.volume",
                    "style": "rotarySlider.default",
                    "presentation": "rotary",
                    "width": 84,
                    "height": 84,
                    "focusOrder": 310
                  }
                ]
