          {
            "id": "listening-studio-mode",
            "type": "component",
            "component": "workspace.studio",
            "style": "textButton.neutral",
            "width": 112,
            "focusOrder": 10
          },
          {
            "id": "listening-listening-mode",
            "type": "component",
            "component": "workspace.listening",
            "style": "textButton.primary",
            "width": 112,
            "focusOrder": 20
          },
          {
            "id": "listening-settings",
            "type": "component",
