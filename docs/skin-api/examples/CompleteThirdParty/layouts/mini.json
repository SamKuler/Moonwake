{
  "apiVersion": 1,
  "preferredSize": {
    "width": 480,
    "height": 200
  },
  "root": {
    "id": "mini-root",
    "type": "stack",
    "style": "surface.example",
    "minWidth": 380,
    "minHeight": 170,
    "children": [
      {
        "id": "mini-shell",
        "type": "column",
        "padding": 12,
        "gap": 8,
        "children": [
          {
            "id": "mini-heading",
            "type": "row",
            "height": 60,
            "gap": 10,
            "align": "center",
            "shrink": 0,
            "children": [
              {
                "id": "artwork-cover",
                "type": "component",
                "component": "artwork.cover",
                "style": "artwork.mini",
                "width": 60,
                "height": 60,
                "shrink": 0
              },
              {
                "id": "mini-title",
                "type": "column",
                "grow": 1,
                "gap": 2,
                "children": [
                  {
                    "id": "nowPlaying-title",
                    "type": "component",
                    "component": "nowPlaying.title",
                    "style": "label.miniTitle",
                    "height": 30,
                    "shrink": 0
                  },
                  {
                    "id": "nowPlaying-artist",
                    "type": "component",
                    "component": "nowPlaying.artist",
                    "style": "label.miniArtist",
                    "height": 22,
                    "shrink": 0
                  }
                ]
              },
              {
                "id": "player-pin",
                "type": "component",
                "component": "player.pin",
                "style": "textButton.neutral",
                "width": 28,
                "height": 28,
                "shrink": 0,
                "focusOrder": 1
              },
              {
                "id": "player-restore",
                "type": "component",
                "component": "player.restore",
                "style": "textButton.neutral",
                "width": 28,
                "height": 28,
                "shrink": 0,
                "focusOrder": 2
              }
            ]
          },
          {
            "id": "lyrics-view",
            "type": "component",
            "component": "lyrics.view",
            "style": "lyrics.line",
            "presentation": "line",
            "height": 28,
            "shrink": 0,
            "focusOrder": 3
          },
          {
            "id": "mini-controls",
            "type": "row",
            "height": 40,
            "align": "center",
            "gap": 8,
            "shrink": 0,
            "children": [
              {
                "id": "transport-previous",
                "type": "component",
                "component": "transport.previous",
                "style": "textButton.neutral",
                "width": 32,
                "height": 32,
                "shrink": 0,
                "focusOrder": 4
              },
              {
                "id": "transport-playPause",
                "type": "component",
                "component": "transport.playPause",
                "style": "textButton.primary",
                "width": 40,
                "height": 40,
                "shrink": 0,
                "focusOrder": 5
              },
              {
                "id": "transport-next",
                "type": "component",
                "component": "transport.next",
                "style": "textButton.neutral",
                "width": 32,
                "height": 32,
                "shrink": 0,
                "focusOrder": 6
              },
              {
                "id": "mini-controls-space",
                "type": "column",
                "grow": 1,
                "children": []
              },
              {
                "id": "transport-volume",
                "type": "component",
                "component": "transport.volume",
                "style": "linearSlider.seek",
                "width": 100,
                "height": 28,
                "presentation": "linearHorizontal",
                "focusOrder": 7
              }
            ]
          }
        ],
        "justify": "spaceBetween",
        "anchors": {
          "left": 0,
          "right": 0,
          "top": 0,
          "bottom": 0
        }
      },
      {
        "id": "mini-status",
        "type": "component",
        "component": "app.status",
        "style": "label.miniNotice",
        "height": 48,
        "zIndex": 100,
        "anchors": {
          "left": 12,
          "right": 12,
          "bottom": 54
        }
      }
    ]
  },
  "ancillaryStyles": {
    "smartPlaylistEditor": "smartPlaylistEditor.default"
  }
}
