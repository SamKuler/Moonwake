{
  "skinApi": 1,
  "id": "com.example.complete-third-party",
  "name": "Complete Third-Party Example",
  "version": "1.0.0",
  "author": {
    "name": "Example Skin Studio"
  },
  "description": "A complete Skin API 1 package with workspace, library and collection layouts.",
  "license": "MIT",
  "minAppVersion": "0.7.0",
  "extends": "builtin.foundation",
  "capabilities": [
    "tokens",
    "renderers",
    "layouts",
    "animations"
  ],
  "entrypoints": {
    "tokens": "tokens.json",
    "components": "components/index.json",
    "layouts": {
      "studio": "layouts/studio.json",
      "listening": "layouts/listening.json",
      "effects": "layouts/effects.json",
      "settings": "layouts/settings.json",
      "library": "layouts/library.json",
      "collection": "layouts/collection.json"
    }
  }
}
