{
  "apiVersion": 1,
  "target": "effectChain",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.panelRadius"
      },
      "fill": {
        "$ref": "colors.surface"
      },
      "stroke": {
        "color": {
          "$ref": "colors.border"
        },
        "width": 1
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": {
        "$ref": "metrics.panelRadius"
      },
      "fill": {
        "$ref": "colors.transparent"
      },
      "stroke": {
        "color": {
          "$ref": "colors.focus"
        },
        "width": 2
      }
    }
  ],
  "variants": {
    "disabled": {
      "body.opacity": 0.4
    }
  },
  "rowLayout": {
    "rowHeight": 92,
    "rowGap": 8,
    "slots": {
      "slot.name": {
        "x": 12,
        "y": 8,
        "width": {
          "$expr": "max(0,bounds.width - 180)"
        },
        "height": 28
      },
      "slot.scope": {
        "x": {
          "$expr": "bounds.width - 156"
        },
        "y": 8,
        "width": 144,
        "height": 28
      },
      "slot.bypass": {
        "x": {
          "$expr": "bounds.width - 188"
        },
        "y": 44,
        "width": 80,
        "height": 28
      },
      "slot.editor": {
        "x": {
          "$expr": "bounds.width - 102"
        },
        "y": 44,
        "width": 56,
        "height": 28
      },
      "slot.remove": {
        "x": {
          "$expr": "bounds.width - 40"
        },
        "y": 44,
        "width": 28,
        "height": 28
      }
    },
    "breakpoints": [
      {
        "when": {
          "minWidth": 600
        },
        "rowHeight": 64,
        "slots": {
          "slot.name": {
            "x": 12,
            "y": 10,
            "width": {
              "$expr": "max(0,bounds.width - 368)"
            },
            "height": 32
          },
          "slot.scope": {
            "x": {
              "$expr": "bounds.width - 340"
            },
            "y": 10,
            "width": 144,
            "height": 32
          },
          "slot.bypass": {
            "x": {
              "$expr": "bounds.width - 188"
            },
            "y": 10,
            "width": 80,
            "height": 32
          },
          "slot.editor": {
            "x": {
              "$expr": "bounds.width - 102"
            },
            "y": 10,
            "width": 56,
            "height": 32
          },
          "slot.remove": {
            "x": {
              "$expr": "bounds.width - 40"
            },
            "y": 12,
            "width": 28,
            "height": 28
          }
        }
      }
    ]
  }
}
