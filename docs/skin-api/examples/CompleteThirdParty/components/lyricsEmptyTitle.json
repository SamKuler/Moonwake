{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "label",
      "type": "text",
      "frame": {
        "x": {
          "$context": "bounds.x"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.36"
        },
        "width": {
          "$context": "bounds.width"
        },
        "height": 36
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.example.body"
      },
      "fontSize": 24,
      "color": {
        "$ref": "colors.example.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ],
  "variants": {
    "focused": {
      "label.color": {
        "$ref": "colors.example.focus"
      }
    }
  }
}
