{
  "textButton": {
    "primary": "components/button-primary.json",
    "neutral": "components/button-neutral.json"
  },
  "surface": {
    "card": "components/surface-card.json",
    "studio": "components/surface-studio.json",
    "collectionCard": "components/collection-card.json"
  },
  "linearSlider": {
    "seek": "components/seek-slider.json"
  },
  "rotarySlider": {
    "default": "components/volume-knob.json"
  },
  "artwork": {
    "default": "components/artwork.json"
  },
  "popupMenu": {
    "studio": "components/popup-menu-studio.json"
  },
  "tooltip": {
    "studio": "components/tooltip-studio.json"
  },
  "scrollBar": {
    "studio": "components/scroll-bar-studio.json"
  },
  "outputStage": {
    "default": "components/output-stage.json"
  },
  "channelMixer": {
    "mixer": {
      "renderer": "components/output-mixer.json",
      "slots": {
        "row.surface": "surface.listRow",
        "row.source": "label.data",
        "row.destination": "label.muted",
        "row.peak": "label.muted",
        "row.gain": "linearSlider.default",
        "row.mute": "toggleButton.default",
        "row.solo": "toggleButton.default"
      }
    }
  },
  "effectChain": {
    "default": {
      "renderer": "components/effect-chain.json",
      "slots": {
        "slot.surface": "surface.card",
        "slot.name": "label.default",
        "slot.scope": "textButton.neutral",
        "slot.bypass": "textButton.neutral",
        "slot.editor": "textButton.neutral",
        "slot.remove": "textButton.defaultCompact"
      }
    }
  },
  "playlistGrid": {
    "default": {
      "renderer": "components/playlist-grid.json",
      "slots": {
        "card.surface": "surface.collectionCard",
        "card.cover": "artwork.default",
        "card.title": "label.default",
        "card.summary": "label.muted",
        "card.date": "label.muted"
      }
    }
  },
  "table": {
    "collection": {
      "renderer": "components/collection-table.json",
      "slots": {
        "cell.artist": "label.default",
        "cell.album": "label.default"
      }
    }
  },
  "directoryList": {
    "default": {
      "renderer": "components/directory-list.json",
      "slots": {
        "row.surface": "surface.skinRow",
        "row.name": "label.default",
        "row.path": "label.muted",
        "row.status": "label.muted",
        "empty.message": "label.muted"
      }
    }
  },
  "smartPlaylistEditor": {
    "default": {
      "renderer": "components/smart-playlist-editor.json",
      "slots": {
        "editor.heading": "label.section",
        "editor.nameLabel": "label.muted",
        "editor.name": "textEditor.default",
        "editor.match": "comboBox.default",
        "editor.rules": "smartPlaylistRuleList.default",
        "editor.add": "textButton.default",
        "editor.preview": "label.muted",
        "editor.save": "textButton.primary",
        "editor.cancel": "textButton.default"
      }
    }
  },
  "smartPlaylistRuleList": {
    "default": {
      "renderer": "components/smart-playlist-rules.json",
      "slots": {
        "rule.field": "comboBox.default",
        "rule.operator": "comboBox.default",
        "rule.value": "textEditor.default",
        "rule.boolean": "comboBox.default",
        "rule.remove": "textButton.default"
      }
    }
  },
  "outputCalibration": {
    "default": {
      "renderer": "components/output-calibration.json",
      "slots": {
        "calibration.channelLabel": "label.muted",
        "calibration.channel": "comboBox.default",
        "calibration.trimLabel": "label.muted",
        "calibration.trim": "textEditor.default",
        "calibration.delayLabel": "label.muted",
        "calibration.delay": "textEditor.default",
        "calibration.polarity": "textButton.default",
        "calibration.signalLabel": "label.muted",
        "calibration.signal": "comboBox.default",
        "calibration.levelLabel": "label.muted",
        "calibration.level": "textEditor.default",
        "calibration.frequencyLabel": "label.muted",
        "calibration.frequency": "textEditor.default",
        "calibration.startStop": "textButton.primary",
        "calibration.status": "label.calibrationStatus"
      }
    }
  }
}
