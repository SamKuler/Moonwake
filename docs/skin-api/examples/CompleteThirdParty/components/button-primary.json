{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.example.controlRadius"
      },
      "fill": {
        "$ref": "colors.example.controlActive"
      },
      "stroke": {
        "color": "#0000001A",
        "width": 1,
        "placement": "inside"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": {
        "$ref": "metrics.example.controlRadius"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.example.focus"
        },
        "width": 2,
        "placement": "inside"
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.example.body"
      },
      "fontSize": 13,
      "color": {
        "$ref": "colors.example.text"
      },
      "align": "center",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ],
  "variants": {
    "hover": {
      "body.opacity": 0.92
    },
    "pressed": {
      "body.opacity": 0.82,
      "label.transform.translateY": 1
    },
    "disabled": {
      "body.opacity": 0.45,
      "label.opacity": 0.58
    }
  },
  "transitions": {
    "hover": {
      "durationMs": {
        "$ref": "durations.example.fast"
      },
      "easing": "easeOut",
      "properties": ["body.opacity"]
    }
  }
}
