{
  "apiVersion": 1,
  "target": "artwork",
  "layers": [
    {
      "id": "image-ambience",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 8
      },
      "radius": {
        "$ref": "metrics.example.surfaceRadius"
      },
      "fill": "#00000000",
      "opacity": 0.18,
      "visible": {
        "$expr": "artwork.hasImage"
      }
    },
    {
      "id": "image-clip",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 20
      },
      "radius": {
        "$ref": "metrics.example.surfaceRadius"
      },
      "fill": "#00000000",
      "clip": true
    }
  ]
}
