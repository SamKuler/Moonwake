{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.example.controlRadius"
      },
      "fill": {
        "$ref": "colors.example.control"
      },
      "stroke": {
        "color": "#00000018",
        "width": 1,
        "placement": "inside"
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.example.body"
      },
      "fontSize": 13,
      "color": {
        "$ref": "colors.example.text"
      },
      "align": "center",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": {
        "$ref": "metrics.example.controlRadius"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.example.focus"
        },
        "width": 2
      }
    }
  ],
  "variants": {
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.78
    },
    "selected": {
      "body.fill": {
        "$ref": "colors.example.controlActive"
      }
    },
    "disabled": {
      "body.opacity": 0.42,
      "label.opacity": 0.55
    }
  }
}
