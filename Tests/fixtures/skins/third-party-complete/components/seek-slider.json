{
  "apiVersion": 1,
  "target": "linearSlider",
  "layers": [
    {
      "id": "track",
      "type": "roundedRect",
      "frame": {
        "x": 4,
        "y": {
          "$expr": "bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "bounds.width - 8"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.example.track"
      }
    },
    {
      "id": "value",
      "type": "roundedRect",
      "frame": {
        "x": 4,
        "y": {
          "$expr": "bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "(bounds.width - 8) * value.normalized"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.example.controlActive"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": 5,
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.example.focus"
        },
        "width": 2,
        "placement": "inside"
      }
    }
  ]
}
