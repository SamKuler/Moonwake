                      {
                        "id": "studio-transport-playPause",
                        "type": "component",
                        "component": "transport.playPause",
                        "style": "textButton.studioIconPrimary",
                        "width": 52,
                        "height": 52,
                        "focusOrder": 220
                      },
                      {
                        "id": "studio-transport-next",
                        "type": "component",
                        "component": "transport.next",
                        "style": "textButton.studioIconNeutral",
                        "width": 40,
                        "height": 40,
                        "focusOrder": 230
                      }
                    ]
                  },
                  {
                    "id": "studio-studio-volume",
                    "type": "column",
                    "width": 180,
                    "height": 56,
                    "anchors": {
                      "right": 0,
                      "centerY": 0
