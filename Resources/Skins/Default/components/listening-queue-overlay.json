{
  "apiVersion": 1,
  "target": "surface",
  "layers": [
    {
      "id": "surface",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.workspaceRadius"
      },
      "fill": {
        "$ref": "colors.listening.surface"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.border"
        },
        "width": 1
      }
    }
  ]
}
