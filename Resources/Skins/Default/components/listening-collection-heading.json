{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "text",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": 36,
      "color": {
        "$ref": "colors.listening.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ]
}
