{
  "apiVersion": 1,
  "target": "surface",
  "layers": [
    {
      "id": "grip",
      "type": "path",
      "visible": {
        "$expr": "state.hover or state.dragging"
      },
      "data": "M1 2 L1 14 M3 2 L3 14",
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.listening.muted"
        },
        "width": 1,
        "cap": "round"
      },
      "transform": {
        "pivotX": 0,
        "pivotY": 0,
        "translateX": {
          "$context": "bounds.x"
        },
        "translateY": {
          "$expr": "bounds.y + (bounds.height - 16) * 0.5"
        }
      }
    }
  ]
}
