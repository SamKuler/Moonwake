{
  "apiVersion": 1,
  "target": "linearSlider",
  "layers": [
    {
      "id": "track",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + 5"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "(bounds.width - 10)"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.listening.track"
      }
    },
    {
      "id": "value",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + 5"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "(bounds.width - 10) * value.normalized"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.listening.active"
      }
    },
    {
      "id": "thumb",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + (bounds.width - 10) * value.normalized"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height - 18) * 0.5"
        },
        "width": 10,
        "height": 18
      },
      "fill": {
        "$ref": "colors.listening.active"
      },
      "radius": 2,
      "stroke": {
        "color": {
          "$ref": "colors.listening.onActive"
        },
        "width": 1
      }
    },
    {
      "id": "thumb-line",
      "type": "line",
      "start": {
        "x": {
          "$expr": "bounds.x + 5 + (bounds.width - 10) * value.normalized"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 5"
        }
      },
      "end": {
        "x": {
          "$expr": "bounds.x + 5 + (bounds.width - 10) * value.normalized"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 + 5"
        }
      },
      "color": {
        "$ref": "colors.listening.onActive"
      },
      "width": 1
    }
  ],
  "variants": {
    "disabled": {
      "track.opacity": 0.4,
      "value.opacity": 0.4,
      "thumb.opacity": 0.4,
      "thumb-line.opacity": 0.4
    },
    "focused": {
      "thumb.frame.height": 22,
      "thumb.frame.y": {
        "$expr": "bounds.y + (bounds.height - 22) * 0.5"
      }
    }
  },
  "controlStyle": {
    "trackBounds": {
      "x": 5,
      "y": {
        "$expr": "bounds.height * 0.5 - 2"
      },
      "width": {
        "$expr": "max(0,bounds.width - 10)"
      },
      "height": 4
    },
    "thumbRadius": 5
  }
}
