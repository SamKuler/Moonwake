{
  "apiVersion": 1,
  "target": "tooltip",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": 6,
      "fill": {
        "$ref": "colors.listening.surface"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.border"
        },
        "width": 1
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": 7
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textSecondary"
      },
      "color": {
        "$ref": "colors.listening.text"
      },
      "align": "left",
      "maxLines": 3,
      "overflow": "ellipsis"
    }
  ]
}
