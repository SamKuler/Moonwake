{
  "apiVersion": 1, "target": "surface",
  "layers": [
    { "id": "selection", "type": "roundedRect", "visible": { "$context": "state.selected" }, "frame": { "anchor": "bounds", "inset": { "top": 2, "right": 4, "bottom": 2, "left": 4 } }, "radius": 6, "fill": "#D6976218" },
    { "id": "divider", "type": "rect", "frame": { "x": 12, "y": { "$expr": "bounds.height - 1" }, "width": { "$expr": "max(0, bounds.width - 24)" }, "height": 1 }, "fill": { "$ref": "colors.studio.border" } }
  ]
}
