{
  "apiVersion": 1,
  "target": "linearSlider",
  "layers": [
    {
      "id": "track",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + 4"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "bounds.width - 8"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.listening.track"
      }
    },
    {
      "id": "value",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + 4"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "(bounds.width - 8) * value.normalized"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.listening.active"
      }
    },
    {
      "id": "thumb",
      "type": "ellipse",
      "frame": {
        "x": {
          "$expr": "bounds.x + 1 + (bounds.width - 8) * value.normalized"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 3"
        },
        "width": 6,
        "height": 6
      },
      "fill": {
        "$ref": "colors.listening.active"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": 5,
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.listening.focus"
        },
        "width": 2
      }
    }
  ],
  "variants": {
    "disabled": {
      "track.opacity": 0.4,
      "value.opacity": 0.4
    }
  },
  "controlStyle": {
    "trackBounds": {
      "x": 4,
      "y": {
        "$expr": "bounds.height * 0.5 - 2"
      },
      "width": {
        "$expr": "max(0,bounds.width - 8)"
      },
      "height": 4
    },
    "thumbRadius": 4
  }
}
