{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.listening.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ],
  "variants": {
    "focused": {
      "label.color": {
        "$ref": "colors.listening.focus"
      }
    }
  }
}
