{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "text",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 16,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ]
}
