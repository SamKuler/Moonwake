{
  "apiVersion": 1,
  "target": "comboBox",
  "layers": [
    {
      "id": "trigger",
      "type": "group",
      "children": [
        {
          "id": "body",
          "type": "roundedRect",
          "frame": {
            "anchor": "bounds",
            "inset": 0.5
          },
          "radius": {
            "$ref": "metrics.studioControlRadius"
          },
          "fill": "#00000000",
          "stroke": {
            "color": {
              "$ref": "colors.studio.border"
            },
            "width": 0,
            "placement": "inside"
          }
        },
        {
          "id": "label",
          "type": "text",
          "frame": {
            "anchor": "contentBounds",
            "inset": {
              "left": 0,
              "right": 34
            }
          },
          "text": {
            "$context": "text.primary"
          },
          "font": {
            "$ref": "fonts.workspaceMedium"
          },
          "fontSize": 36,
          "color": {
            "$ref": "colors.studio.text"
          },
          "align": "left",
          "maxLines": 1,
          "overflow": "ellipsis"
        },
        {
          "id": "chevron",
          "type": "path",
          "data": "M 0 0 L 4 4 L 8 0",
          "fill": "#00000000",
          "stroke": {
            "color": {
              "$ref": "colors.studio.muted"
            },
            "width": 1.5,
            "cap": "round"
          },
          "transform": {
            "translateX": {
              "$expr": "bounds.x + bounds.width - 22"
            },
            "translateY": {
              "$expr": "bounds.y + bounds.height * 0.5 - 2"
            }
          }
        }
      ]
    }
  ],
  "variants": {
    "hover": {
      "body.fill": {
        "$expr": "alpha(token.colors.studio.text, 0.04)"
      }
    },
    "pressed": {
      "body.opacity": 0.76
    },
    "focused": {
      "body.fill": {
        "$expr": "alpha(token.colors.studio.focus, 0.08)"
      }
    },
    "disabled": {
      "body.opacity": 0.4,
      "label.opacity": 0.7,
      "chevron.opacity": 0.55
    }
  }
}
