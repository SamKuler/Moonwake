{
  "apiVersion": 1,
  "target": "pluginList",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.listening.border"
        },
        "width": 0,
        "placement": "inside"
      }
    }
  ],
  "variants": {
    "focused": {
      "body.stroke.color": {
        "$ref": "colors.listening.focus"
      },
      "body.stroke.width": 1.5
    }
  }
}
