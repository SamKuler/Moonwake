{
  "apiVersion": 1,
  "target": "toggleButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.controlRadius"
      },
      "fill": {
        "$ref": "colors.listening.control"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.border"
        },
        "width": 1
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.controlRadius"
      },
      "fill": {
        "$expr": "alpha(token.colors.listening.focus, token.metrics.focusOverlayOpacity)"
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 10,
          "right": 10
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textControl"
      },
      "color": {
        "$ref": "colors.listening.text"
      },
      "align": "center",
      "maxLines": 1
    }
  ],
  "variants": {
    "selected": {
      "body.fill": {
        "$ref": "colors.listening.active"
      },
      "label.color": {
        "$ref": "colors.listening.onActive"
      },
      "focus.fill": {
        "$expr": "alpha(token.colors.listening.onActive, token.metrics.focusOverlayOpacity)"
      }
    },
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.75
    },
    "disabled": {
      "body.opacity": 0.4,
      "label.opacity": 0.55
    }
  }
}
