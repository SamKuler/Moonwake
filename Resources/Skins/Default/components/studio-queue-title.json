{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "title",
      "type": "text",
      "frame": {
        "x": {
          "$expr": "bounds.x + 34"
        },
        "y": {
          "$expr": "bounds.y + 8"
        },
        "width": {
          "$expr": "max(0, bounds.width - 58)"
        },
        "height": 21
      },
      "text": {
        "$context": "row.title"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textBody"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "artist",
      "type": "text",
      "frame": {
        "x": {
          "$expr": "bounds.x + 34"
        },
        "y": {
          "$expr": "bounds.y + 30"
        },
        "width": {
          "$expr": "max(0, bounds.width - 58)"
        },
        "height": 18
      },
      "text": {
        "$context": "row.artist"
      },
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textSecondary"
      },
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "playing",
      "type": "path",
      "data": "M0 8 L2 8 L2 12 L0 12 Z M4 5 L6 5 L6 12 L4 12 Z M8 7 L10 7 L10 12 L8 12 Z",
      "visible": {
        "$expr": "row.playing and not row.animating"
      },
      "fill": {
        "$ref": "colors.studio.active"
      },
      "transform": {
        "pivotX": 0,
        "pivotY": 0,
        "translateX": {
          "$expr": "bounds.x + 12"
        },
        "translateY": {
          "$expr": "bounds.y + (bounds.height - 12) * 0.5"
        }
      }
    },
    {
      "id": "playing-bar-1",
      "type": "roundedRect",
      "visible": {
        "$context": "row.animating"
      },
      "frame": {
        "x": {
          "$expr": "bounds.x + 12"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height + 12) * 0.5 - (3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.5 + 0 - round(row.playbackSeconds * 1.5 + 0)))))"
        },
        "width": 2,
        "height": {
          "$expr": "3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.5 + 0 - round(row.playbackSeconds * 1.5 + 0))))"
        }
      },
      "radius": 1,
      "fill": {
        "$ref": "colors.studio.active"
      }
    },
    {
      "id": "playing-bar-2",
      "type": "roundedRect",
      "visible": {
        "$context": "row.animating"
      },
      "frame": {
        "x": {
          "$expr": "bounds.x + 16"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height + 12) * 0.5 - (3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.1 + 0.3 - round(row.playbackSeconds * 1.1 + 0.3)))))"
        },
        "width": 2,
        "height": {
          "$expr": "3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.1 + 0.3 - round(row.playbackSeconds * 1.1 + 0.3))))"
        }
      },
      "radius": 1,
      "fill": {
        "$ref": "colors.studio.active"
      }
    },
    {
      "id": "playing-bar-3",
      "type": "roundedRect",
      "visible": {
        "$context": "row.animating"
      },
      "frame": {
        "x": {
          "$expr": "bounds.x + 20"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height + 12) * 0.5 - (3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.3 + 0.6 - round(row.playbackSeconds * 1.3 + 0.6)))))"
        },
        "width": 2,
        "height": {
          "$expr": "3 + 9 * (1 - abs(2 * (row.playbackSeconds * 1.3 + 0.6 - round(row.playbackSeconds * 1.3 + 0.6))))"
        }
      },
      "radius": 1,
      "fill": {
        "$ref": "colors.studio.active"
      }
    },
    {
      "id": "favourite",
      "type": "path",
      "data": "M4 0 L5.2 2.8 L8 3 L5.9 5 L6.5 8 L4 6.5 L1.5 8 L2.1 5 L0 3 L2.8 2.8 Z",
      "visible": {
        "$context": "row.favourite"
      },
      "fill": {
        "$ref": "colors.studio.active"
      },
      "transform": {
        "pivotX": 0,
        "pivotY": 0,
        "translateX": {
          "$expr": "bounds.x + bounds.width - 16"
        },
        "translateY": {
          "$expr": "bounds.y + (bounds.height - 8) * 0.5"
        }
      }
    }
  ]
}
