{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.controlRadius"
      },
      "fill": {
        "$ref": "colors.listening.active"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.focus"
        },
        "width": 1
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.controlRadius"
      },
      "fill": {
        "$expr": "alpha(token.colors.listening.onActive, token.metrics.focusOverlayOpacity)"
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 34,
          "right": 10
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textControl"
      },
      "color": {
        "$ref": "colors.listening.onActive"
      },
      "align": "center",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ],
  "variants": {
    "selected": {
      "body.opacity": 0.86
    },
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.76,
      "label.transform.translateY": 1
    },
    "disabled": {
      "body.fill": {
        "$ref": "colors.listening.control"
      },
      "body.stroke.color": {
        "$ref": "colors.listening.border"
      },
      "label.color": {
        "$ref": "colors.listening.muted"
      },
      "label.opacity": 0.62
    }
  },
  "transitions": {
    "hover": {
      "durationMs": {
        "$ref": "durations.workspaceFast"
      },
      "easing": "easeOut",
      "properties": [
        "body.opacity"
      ]
    }
  },
  "controlStyle": {
    "iconBounds": {
      "x": 12,
      "y": {
        "$expr": "(bounds.height - 20) * 0.5"
      },
      "width": 20,
      "height": 20
    }
  }
}
