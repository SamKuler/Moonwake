{
  "apiVersion": 1,
  "target": "toggleButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.studioControlRadius"
      },
      "fill": {
        "$ref": "colors.studio.control"
      },
      "stroke": {
        "color": {
          "$ref": "colors.studio.border"
        },
        "width": 1
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 2,
          "right": 2
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textControl"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "center",
      "maxLines": 1
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": {
        "$ref": "metrics.studioControlRadius"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.studio.focus"
        },
        "width": 2
      }
    }
  ],
  "variants": {
    "selected": {
      "body.fill": {
        "$ref": "colors.studio.active"
      },
      "label.color": {
        "$ref": "colors.studio.onActive"
      }
    },
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.75
    },
    "disabled": {
      "body.opacity": 0.4,
      "label.opacity": 0.55
    },
    "focused": {
      "body.stroke.width": 0
    }
  }
}
