{
  "apiVersion": 1,
  "target": "surface",
  "layers": [
    {
      "id": "selection",
      "type": "rect",
      "visible": {
        "$context": "state.selected"
      },
      "frame": {
        "anchor": "bounds"
      },
      "fill": "#9CCBD818"
    },
    {
      "id": "divider",
      "type": "rect",
      "frame": {
        "x": {
          "$context": "bounds.x"
        },
        "y": {
          "$expr": "bounds.height - 1"
        },
        "width": {
          "$context": "bounds.width"
        },
        "height": 1
      },
      "fill": {
        "$ref": "colors.studio.border"
      }
    }
  ],
  "variants": {
    "focused": {
      "selection.fill": "#9CCBD82C"
    }
  }
}
