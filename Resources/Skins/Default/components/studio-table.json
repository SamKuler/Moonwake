{
  "apiVersion": 1,
  "target": "table",
  "layers": [
    {
      "id": "body",
      "type": "rect",
      "frame": {
        "anchor": "bounds"
      },
      "fill": "#00000000"
    }
  ],
  "variants": {
    "focused": {
      "body.fill": "#9CCBD80A"
    }
  },
  "rowLayout": {
    "rowHeight": 40,
    "rowGap": 0,
    "headerHeight": 28,
    "slots": {
      "row.surface": {
        "x": 0,
        "y": 0,
        "width": {
          "$expr": "bounds.width"
        },
        "height": {
          "$context": "layout.rowHeight"
        }
      },
      "cell.title": {
        "x": 0,
        "y": 0,
        "width": {
          "$expr": "(bounds.width - 64) * 0.4"
        },
        "height": {
          "$context": "layout.rowHeight"
        }
      },
      "cell.location": {
        "x": {
          "$expr": "(bounds.width - 64) * 0.4"
        },
        "y": 0,
        "width": {
          "$expr": "(bounds.width - 64) * 0.6"
        },
        "height": {
          "$context": "layout.rowHeight"
        }
      },
      "cell.duration": {
        "x": {
          "$expr": "bounds.width - 64"
        },
        "y": 0,
        "width": 64,
        "height": {
          "$context": "layout.rowHeight"
        }
      }
    }
  }
}
