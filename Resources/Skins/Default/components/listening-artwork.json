{
  "apiVersion": 1,
  "target": "artwork",
  "layers": [
    {
      "id": "image-ambience",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 4
      },
      "radius": 24,
      "opacity": 0.22,
      "fill": "#00000000"
    },
    {
      "id": "sleeve",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + (bounds.width - (max(0, min(bounds.width - 64, bounds.height - 28)))) * 0.5"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height - (max(0, min(bounds.width - 64, bounds.height - 28)))) * 0.5"
        },
        "width": {
          "$expr": "max(0, min(bounds.width - 64, bounds.height - 28))"
        },
        "height": {
          "$expr": "max(0, min(bounds.width - 64, bounds.height - 28))"
        }
      },
      "radius": 10,
      "fill": {
        "$ref": "colors.listening.surface"
      },
      "shadow": {
        "color": "#152D4038",
        "radius": 22,
        "offsetX": 0,
        "offsetY": 8
      }
    },
    {
      "id": "image-clip",
      "type": "roundedRect",
      "frame": {
        "x": {
          "$expr": "bounds.x + (bounds.width - (max(0, min(bounds.width - 64, bounds.height - 28)))) * 0.5"
        },
        "y": {
          "$expr": "bounds.y + (bounds.height - (max(0, min(bounds.width - 64, bounds.height - 28)))) * 0.5"
        },
        "width": {
          "$expr": "max(0, min(bounds.width - 64, bounds.height - 28))"
        },
        "height": {
          "$expr": "max(0, min(bounds.width - 64, bounds.height - 28))"
        }
      },
      "radius": 10,
      "fill": "#00000000",
      "clip": true
    },
    {
      "id": "empty-disc",
      "type": "ellipse",
      "visible": {
        "$expr": "not artwork.hasImage"
      },
      "frame": {
        "x": {
          "$expr": "bounds.width * 0.5 - 72"
        },
        "y": {
          "$expr": "bounds.height * 0.5 - 72"
        },
        "width": 144,
        "height": 144
      },
      "fill": {
        "$ref": "colors.listening.control"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.border"
        },
        "width": 1
      }
    },
    {
      "id": "disc-centre",
      "type": "ellipse",
      "visible": {
        "$expr": "not artwork.hasImage"
      },
      "frame": {
        "x": {
          "$expr": "bounds.width * 0.5 - 14"
        },
        "y": {
          "$expr": "bounds.height * 0.5 - 14"
        },
        "width": 28,
        "height": 28
      },
      "fill": {
        "$ref": "colors.listening.surface"
      }
    }
  ]
}
