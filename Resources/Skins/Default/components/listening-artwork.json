{
  "apiVersion": 1, "target": "artwork",
  "layers": [
    { "id": "body", "type": "roundedRect", "frame": { "anchor": "bounds", "inset": 0.5 }, "radius": { "$ref": "metrics.workspaceRadius" }, "fill": { "$ref": "colors.listening.control" }, "stroke": { "color": { "$ref": "colors.listening.border" }, "width": 1 } },
    { "id": "image-clip", "type": "roundedRect", "frame": { "x": { "$expr": "bounds.width * 0.1" }, "y": { "$expr": "bounds.height * 0.17" }, "width": { "$expr": "bounds.width * 0.8" }, "height": { "$expr": "bounds.width * 0.8" } }, "radius": 12, "fill": "#00000000", "clip": true },
    { "id": "sleeve", "type": "roundedRect", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.1" }, "y": { "$expr": "bounds.height * 0.17" }, "width": { "$expr": "bounds.width * 0.8" }, "height": { "$expr": "bounds.width * 0.8" } }, "radius": 12, "fill": { "$ref": "colors.listening.surface" }, "stroke": { "color": { "$ref": "colors.listening.border" }, "width": 1 } },
    { "id": "record", "type": "ellipse", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.19" }, "y": { "$expr": "bounds.height * 0.17 + bounds.width * 0.06" }, "width": { "$expr": "bounds.width * 0.62" }, "height": { "$expr": "bounds.width * 0.62" } }, "fill": "#282621FF", "stroke": { "color": "#4E4940FF", "width": 2 } },
    { "id": "groove-a", "type": "ellipse", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.25" }, "y": { "$expr": "bounds.height * 0.17 + bounds.width * 0.12" }, "width": { "$expr": "bounds.width * 0.50" }, "height": { "$expr": "bounds.width * 0.50" } }, "fill": "#00000000", "stroke": { "color": "#F3EEE620", "width": 1 } },
    { "id": "groove-b", "type": "ellipse", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.30" }, "y": { "$expr": "bounds.height * 0.17 + bounds.width * 0.17" }, "width": { "$expr": "bounds.width * 0.40" }, "height": { "$expr": "bounds.width * 0.40" } }, "fill": "#00000000", "stroke": { "color": "#F3EEE620", "width": 1 } },
    { "id": "disc-label", "type": "ellipse", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.40" }, "y": { "$expr": "bounds.height * 0.17 + bounds.width * 0.27" }, "width": { "$expr": "bounds.width * 0.20" }, "height": { "$expr": "bounds.width * 0.20" } }, "fill": { "$ref": "colors.listening.active" } },
    { "id": "title", "type": "text", "visible": { "$expr": "artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.18" }, "y": { "$expr": "bounds.height * 0.17 + bounds.width * 0.70" }, "width": { "$expr": "bounds.width * 0.64" }, "height": 32 }, "text": "NOW SPINNING", "font": { "$ref": "fonts.workspaceTitle" }, "fontSize": 14, "color": { "$ref": "colors.listening.text" }, "align": "center", "maxLines": 1, "overflow": "ellipsis" },
    { "id": "empty-mark", "type": "ellipse", "visible": { "$expr": "not artwork.hasTrack" }, "frame": { "x": { "$expr": "bounds.width * 0.5 - 52" }, "y": { "$expr": "bounds.height * 0.5 - 72" }, "width": 104, "height": 104 }, "fill": { "$ref": "colors.listening.surface" }, "stroke": { "color": { "$ref": "colors.listening.border" }, "width": 1 } },
    { "id": "empty-label", "type": "text", "visible": { "$expr": "not artwork.hasTrack" }, "frame": { "x": 24, "y": { "$expr": "bounds.height * 0.5 + 48" }, "width": { "$expr": "bounds.width - 48" }, "height": 40 }, "text": "NO RECORD SELECTED", "font": { "$ref": "fonts.workspaceTitle" }, "fontSize": 14, "color": { "$ref": "colors.listening.muted" }, "align": "center", "maxLines": 1 }
  ]
}
