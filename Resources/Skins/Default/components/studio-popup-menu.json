{
  "apiVersion": 1,
  "target": "popupMenu",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "visible": {
        "$expr": "menu.part == 'background'"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1
      },
      "radius": 8,
      "fill": {
        "$ref": "colors.studio.surface"
      },
      "stroke": {
        "color": {
          "$ref": "colors.studio.border"
        },
        "width": 1,
        "placement": "inside"
      }
    },
    {
      "id": "highlight",
      "type": "roundedRect",
      "visible": {
        "$expr": "menu.part == 'item' and (state.hover or state.selected)"
      },
      "frame": {
        "anchor": "bounds",
        "inset": {
          "top": 3,
          "right": 5,
          "bottom": 3,
          "left": 5
        }
      },
      "radius": 5,
      "fill": "#9CCBD820"
    },
    {
      "id": "separator",
      "type": "rect",
      "visible": {
        "$expr": "menu.part == 'separator'"
      },
      "frame": {
        "x": 12,
        "y": {
          "$expr": "bounds.height * 0.5"
        },
        "width": {
          "$expr": "max(0, bounds.width - 24)"
        },
        "height": 1
      },
      "fill": {
        "$ref": "colors.studio.border"
      }
    },
    {
      "id": "label",
      "type": "text",
      "visible": {
        "$expr": "menu.part == 'item'"
      },
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 34,
          "right": 28
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textControl"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "section",
      "type": "text",
      "visible": {
        "$expr": "menu.part == 'sectionHeader'"
      },
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 14,
          "right": 14
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textCaption"
      },
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "check",
      "type": "path",
      "visible": {
        "$expr": "menu.part == 'item' and icon.name == 'checked'"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.studio.text"
        },
        "width": 1.8,
        "cap": "round"
      },
      "data": "M2 6 L5 9 L11 2",
      "transform": {
        "pivotX": 0,
        "pivotY": 0,
        "translateX": 12,
        "translateY": {
          "$expr": "(bounds.height - 12) * 0.5"
        }
      }
    },
    {
      "id": "submenu",
      "type": "text",
      "visible": {
        "$expr": "menu.part == 'item' and icon.name == 'submenu'"
      },
      "frame": {
        "x": {
          "$expr": "bounds.width - 27"
        },
        "y": 0,
        "width": 17,
        "height": {
          "$expr": "bounds.height"
        }
      },
      "text": "\u203a",
      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "center",
      "maxLines": 1
    },
    {
      "id": "scroll-up",
      "type": "text",
      "visible": {
        "$expr": "menu.part == 'item' and icon.name == 'scrollUp'"
      },
      "frame": {
        "anchor": "bounds"
      },
      "text": "\u25b2",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 9,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "center",
      "maxLines": 1
    },
    {
      "id": "scroll-down",
      "type": "text",
      "visible": {
        "$expr": "menu.part == 'item' and icon.name == 'scrollDown'"
      },
      "frame": {
        "anchor": "bounds"
      },
      "text": "\u25bc",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 9,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "center",
      "maxLines": 1
    }
  ],
  "variants": {
    "selected": {
      "highlight.fill": "#9CCBD828"
    },
    "hover": {
      "highlight.fill": "#9CCBD820"
    },
    "disabled": {
      "label.opacity": 0.45
    }
  },
  "rowLayout": {
    "rowHeight": 34,
    "slots": {}
  }
}
