{
  "apiVersion": 1,
  "target": "surface",
  "layers": [
    {
      "id": "card",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds"
      },
      "radius": 10,
      "fill": "#00000000"
    }
  ],
  "variants": {
    "hover": {
      "card.fill": {
        "$expr": "alpha(token.colors.studio.text, 0.04)"
      }
    },
    "focused": {
      "card.fill": {
        "$expr": "alpha(token.colors.studio.focus, 0.12)"
      }
    },
    "pressed": {
      "card.fill": {
        "$expr": "alpha(token.colors.studio.focus, 0.18)"
      }
    }
  }
}
