{
  "apiVersion": 1,
  "target": "scrollBar",
  "layers": [
    {
      "id": "track",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 2
      },
      "radius": 4,
      "fill": {
        "$ref": "colors.studio.surface"
      }
    },
    {
      "id": "thumb",
      "type": "roundedRect",
      "frame": {
        "anchor": "contentBounds",
        "inset": 3
      },
      "radius": 4,
      "fill": {
        "$ref": "colors.studio.muted"
      }
    }
  ],
  "variants": {
    "hover": {
      "thumb.fill": {
        "$ref": "colors.studio.text"
      }
    },
    "pressed": {
      "thumb.fill": {
        "$ref": "colors.studio.active"
      }
    },
    "disabled": {
      "thumb.opacity": 0.35
    }
  }
}
