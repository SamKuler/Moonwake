{
  "apiVersion": 1, "target": "textButton",
  "layers": [
    { "id": "body", "type": "roundedRect", "frame": { "anchor": "bounds", "inset": 0.5 }, "radius": { "$ref": "metrics.controlRadius" }, "fill": { "$ref": "colors.listening.active" }, "stroke": { "color": { "$ref": "colors.listening.focus" }, "width": 1 } },
    { "id": "focus", "type": "roundedRect", "visible": { "$context": "state.focused" }, "frame": { "anchor": "bounds", "inset": 1.5 }, "radius": { "$ref": "metrics.controlRadius" }, "fill": "#00000000", "stroke": { "color": { "$ref": "colors.listening.focus" }, "width": 2 } }
  ],
  "variants": { "selected": { "body.opacity": 0.86 }, "hover": { "body.opacity": 0.9 }, "pressed": { "body.opacity": 0.76 }, "disabled": { "body.opacity": 0.4 } },
  "transitions": { "hover": { "durationMs": { "$ref": "durations.workspaceFast" }, "easing": "easeOut", "properties": ["body.opacity"] } }
}
