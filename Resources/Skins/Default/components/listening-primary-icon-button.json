{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": 28,
      "fill": {
        "$ref": "colors.listening.active"
      },
      "stroke": {
        "color": {
          "$ref": "colors.listening.focus"
        },
        "width": 0
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 1.5
      },
      "radius": 28,
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.listening.focus"
        },
        "width": 2
      }
    }
  ],
  "variants": {
    "selected": {
      "body.opacity": 0.86
    },
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.76
    },
    "disabled": {
      "body.opacity": 0.4
    },
    "focused": {
      "body.stroke.width": 0
    }
  },
  "transitions": {
    "hover": {
      "durationMs": {
        "$ref": "durations.workspaceFast"
      },
      "easing": "easeOut",
      "properties": [
        "body.opacity"
      ]
    }
  },
  "controlStyle": {
    "iconBounds": {
      "x": {
        "$expr": "(bounds.width - 20) * 0.5"
      },
      "y": {
        "$expr": "(bounds.height - 20) * 0.5"
      },
      "width": 20,
      "height": 20
    }
  }
}
