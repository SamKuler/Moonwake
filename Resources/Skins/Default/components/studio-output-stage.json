    {
      "id": "single-meters",
      "type": "repeat",
      "source": "meter.channels",
      "limit": 16,
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      },
      "template": {
        "id": "single-meters-channel",
        "type": "group",
        "children": [
          {
            "id": "single-meters-well",
            "type": "roundedRect",
            "visible": {
              "$expr": "true"
            },
            "frame": {
              "x": {
                "$expr": "((bounds.width - (44 + (meter.channelCount) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))))) * 0.5) + 44 + (item.index) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 44) / max(1, meter.channelCount))) - 14) * 0.5"
              },
              "y": {
                "$expr": "80"
              },
              "width": 14,
              "height": {
                "$expr": "max(60, bounds.height - 156)"
              }
            },
            "radius": 2,
            "fill": {
              "$ref": "colors.studio.background"
            }
          },
          {
            "id": "single-meters-peak",
            "type": "rect",
            "visible": {
              "$expr": "true"
            },
            "frame": {
              "x": {
                "$expr": "(((bounds.width - (44 + (meter.channelCount) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))))) * 0.5) + 44 + (item.index) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 44) / max(1, meter.channelCount))) - 14) * 0.5) + 1"
              },
              "y": {
                "$expr": "(80) + (max(60, bounds.height - 156)) * (1 - clamp((item.peakDb + 60) / 60, 0, 1))"
              },
              "width": 12,
              "height": {
                "$expr": "(max(60, bounds.height - 156)) * clamp((item.peakDb + 60) / 60, 0, 1)"
              }
            },
            "fill": {
              "$ref": "colors.studio.active"
            }
          },
          {
            "id": "single-meters-rms",
            "type": "rect",
            "visible": {
              "$expr": "(true) and meter.mode == 'rms'"
            },
            "frame": {
              "x": {
                "$expr": "(((bounds.width - (44 + (meter.channelCount) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))))) * 0.5) + 44 + (item.index) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 44) / max(1, meter.channelCount))) - 14) * 0.5) + 4"
              },
              "y": {
                "$expr": "(80) + (max(60, bounds.height - 156)) * (1 - clamp((item.rmsDb + 60) / 60, 0, 1))"
              },
              "width": 6,
              "height": {
                "$expr": "(max(60, bounds.height - 156)) * clamp((item.rmsDb + 60) / 60, 0, 1)"
              }
            },
            "fill": "#F0CE7AFF"
          },
          {
            "id": "single-meters-name",
            "type": "text",
            "frame": {
              "x": {
                "$expr": "((bounds.width - (44 + (meter.channelCount) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))))) * 0.5) + 44 + (item.index) * (min(32, (bounds.width - 44) / max(1, meter.channelCount)))"
              },
              "y": {
                "$expr": "(80) + (max(60, bounds.height - 156)) + 5"
              },
              "width": {
                "$expr": "min(32, (bounds.width - 44) / max(1, meter.channelCount))"
              },
              "height": 20
            },
            "text": {
              "$context": "item.label"
            },
            "font": {
              "$ref": "fonts.workspaceBody"
            },
            "fontSize": {
              "$ref": "metrics.textCaption"
            },
            "color": {
              "$ref": "colors.studio.text"
            },
            "align": "center",
            "maxLines": 1,
            "overflow": "ellipsis",
            "visible": {
              "$expr": "true"
            }
          }
        ]
      }
