        "x": 42,
        "y": {
          "$expr": "(72) + (max(48,bounds.height - 188)) * 3 / 3"
        },
        "width": {
          "$expr": "max(0,bounds.width - 42)"
        },
        "height": 1
      },
      "fill": {
        "$ref": "colors.studio.border"
      },
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      }
    },
    {
      "id": "single-meters",
      "type": "repeat",
      "source": "meter.channels",
      "limit": 16,
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      },
      "template": {
        "id": "single-meter",
        "type": "group",
        "children": [
          {
            "id": "single-track",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "42 + (item.index - 0) * ((bounds.width - 42) / max(1,meter.channelCount)) + (((bounds.width - 42) / max(1,meter.channelCount)) - (max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12)))) * 0.5"
              },
              "y": {
                "$expr": "72"
              },
              "width": {
                "$expr": "max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12))"
              },
              "height": {
                "$expr": "max(48,bounds.height - 188)"
              }
            },
            "fill": {
              "$ref": "colors.studio.background"
            },
            "visible": {
              "$expr": "item.index >= 0 and item.index < 8"
            }
          },
          {
            "id": "single-peak",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "42 + (item.index - 0) * ((bounds.width - 42) / max(1,meter.channelCount)) + (((bounds.width - 42) / max(1,meter.channelCount)) - (max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12)))) * 0.5"
              },
              "y": {
                "$expr": "((72) + (max(48,bounds.height - 188))) - (max(48,bounds.height - 188)) * clamp((item.peakDb + 60) / 60,0,1)"
              },
              "width": {
                "$expr": "max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12))"
              },
              "height": {
                "$expr": "(max(48,bounds.height - 188)) * clamp((item.peakDb + 60) / 60,0,1)"
              }
            },
            "fill": {
              "$ref": "colors.studio.active"
            },
            "visible": {
              "$expr": "(item.index >= 0 and item.index < 8) and meter.mode != 'rms'"
            }
          },
          {
            "id": "single-rms-fill",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "42 + (item.index - 0) * ((bounds.width - 42) / max(1,meter.channelCount)) + (((bounds.width - 42) / max(1,meter.channelCount)) - (max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12)))) * 0.5"
              },
              "y": {
                "$expr": "((72) + (max(48,bounds.height - 188))) - (max(48,bounds.height - 188)) * clamp((item.rmsSineDb + 60) / 60,0,1)"
              },
              "width": {
                "$expr": "max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12))"
              },
              "height": {
                "$expr": "(max(48,bounds.height - 188)) * clamp((item.rmsSineDb + 60) / 60,0,1)"
              }
            },
            "fill": {
              "$ref": "colors.studio.active"
            },
            "visible": {
              "$expr": "(item.index >= 0 and item.index < 8) and meter.mode == 'rms'"
            }
          },
          {
            "id": "single-rms",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "42 + (item.index - 0) * ((bounds.width - 42) / max(1,meter.channelCount)) + (((bounds.width - 42) / max(1,meter.channelCount)) - (max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12)))) * 0.5"
              },
              "y": {
                "$expr": "((72) + (max(48,bounds.height - 188))) - (max(48,bounds.height - 188)) * clamp((item.truePeakDb + 60) / 60,0,1)"
              },
              "width": {
                "$expr": "max(4,min(48,((bounds.width - 42) / max(1,meter.channelCount)) - 12))"
              },
              "height": 1.5
            },
            "fill": {
              "$ref": "colors.studio.text"
            },
            "visible": {
              "$expr": "item.index >= 0 and item.index < 8 and meter.mode == 'rms' and item.truePeakDb > -60"
            }
          },
          {
            "id": "single-channel",
            "type": "text",
            "frame": {
              "x": {
                "$expr": "42 + (item.index - 0) * ((bounds.width - 42) / max(1,meter.channelCount))"
              },
              "y": {
                "$expr": "(72) + (max(48,bounds.height - 188)) + 4"
              },
              "width": {
                "$expr": "(bounds.width - 42) / max(1,meter.channelCount)"
              },
              "height": 22
            },
            "text": {
              "$context": "item.label"
            },
            "font": {
              "$ref": "fonts.workspaceBody"
            },
            "fontSize": 16,
            "color": {
              "$ref": "colors.studio.text"
            },
            "align": "center",
            "maxLines": 1,
            "overflow": "ellipsis",
            "visible": {
              "$expr": "item.index >= 0 and item.index < 8"
            }
          }
        ]
      }
    },
