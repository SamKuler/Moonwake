        "x": 0,
        "y": 0,
        "width": 160,
        "height": 28
      },
      "text": "Output",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textSection"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "peak-label",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "Sample peak · dBFS",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textSecondary"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode == 'peak'"
      }
    },
    {
      "id": "rms-label",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "Peak + RMS · dBFS",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": {
        "$ref": "metrics.textSecondary"
      },
      "color": {
