      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode == 'loudness'"
      }
    },
    {
      "id": "single-scale-0",
      "type": "text",
      "frame": {
        "x": {
          "$expr": "(bounds.width - (44 + (meter.channelCount) * (min(32, (bounds.width - 44) / max(1, meter.channelCount))))) * 0.5"
        },
        "y": {
          "$expr": "((80) + (max(60, bounds.height - 156)) * 0.0) - 9"
