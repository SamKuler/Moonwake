{
  "apiVersion": 1,
  "target": "outputStage",
  "layers": [
    {
      "id": "heading",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 0,
        "width": 160,
        "height": 28
      },
      "text": "Output",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 22,
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "peak-label",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "Sample peak \u00b7 dBFS",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode == 'peak' and not meter.interrupted"
      }
    },
    {
      "id": "rms-label",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "RMS bars \u00b7 sine ref / True peak line",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode == 'rms' and not meter.interrupted"
      }
    },
    {
      "id": "loudness-label",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "Loudness \u00b7 LUFS",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode == 'loudness' and not meter.interrupted"
      }
    },
    {
      "id": "interruption",
      "type": "text",
      "frame": {
        "x": 0,
        "y": 32,
        "width": {
          "$expr": "bounds.width"
        },
        "height": 24
      },
      "text": "Measurement restarted",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 17,
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.interrupted"
      }
    },
    {
      "id": "single-scale-0",
      "type": "text",
      "frame": {
        "x": 0,
        "y": {
          "$expr": "(72) + (max(48,bounds.height - 188)) * 0 / 3 - 10"
        },
        "width": 32,
        "height": 20
      },
      "text": "0",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 15,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "right",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      }
    },
    {
      "id": "single-grid-0",
      "type": "rect",
      "frame": {
        "x": 42,
        "y": {
          "$expr": "(72) + (max(48,bounds.height - 188)) * 0 / 3"
        },
        "width": {
          "$expr": "max(0,bounds.width - 42)"
        },
        "height": 1
      },
      "fill": {
        "$ref": "colors.studio.border"
      },
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      }
    },
    {
      "id": "single-scale-1",
      "type": "text",
      "frame": {
        "x": 0,
        "y": {
          "$expr": "(72) + (max(48,bounds.height - 188)) * 1 / 3 - 10"
        },
        "width": 32,
        "height": 20
      },
      "text": "-20",
      "font": {
        "$ref": "fonts.workspaceBody"
      },
      "fontSize": 15,
      "color": {
        "$ref": "colors.studio.muted"
      },
      "align": "right",
      "maxLines": 1,
      "overflow": "ellipsis",
      "visible": {
        "$expr": "meter.mode != 'loudness' and (meter.channelCount <= 8)"
      }
