      "font": {
        "$ref": "fonts.workspaceMedium"
      },
      "fontSize": {
        "$ref": "metrics.textSection"
      },
      "color": {
        "$ref": "colors.studio.text"
      },
      "align": "left",
      "maxLines": 1,
      "overflow": "ellipsis"
    },
    {
      "id": "layout",
      "type": "text",
      "frame": {
        "x": {
          "$expr": "bounds.width - 110"
