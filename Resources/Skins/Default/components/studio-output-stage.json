    {
      "id": "channels",
      "type": "repeat",
      "source": "meter.channels",
      "limit": 10,
      "template": {
        "id": "meter",
        "type": "group",
        "children": [
          {
            "id": "meter-track",
            "type": "roundedRect",
            "frame": {
              "x": {
                "$expr": "((bounds.width - (meter.channelCount * (min(32, (bounds.width - 64) / max(1, meter.channelCount)))) + 40) / 2) + item.index * (min(32, (bounds.width - 64) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 64) / max(1, meter.channelCount))) - 16) / 2"
              },
              "y": 84,
              "width": 16,
              "height": {
                "$expr": "(bounds.height - 172)"
              }
            },
            "radius": 2,
            "fill": {
              "$ref": "colors.studio.background"
            }
          },
          {
            "id": "meter-value",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "((bounds.width - (meter.channelCount * (min(32, (bounds.width - 64) / max(1, meter.channelCount)))) + 40) / 2) + item.index * (min(32, (bounds.width - 64) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 64) / max(1, meter.channelCount))) - 16) / 2"
              },
              "y": {
                "$expr": "84 + (bounds.height - 172) * (1 - clamp((item.peakDb + 60) / 60, 0, 1))"
              },
              "width": 16,
              "height": {
                "$expr": "(bounds.height - 172) * clamp((item.peakDb + 60) / 60, 0, 1)"
              }
            },
            "fill": {
              "$ref": "colors.studio.active"
            },
            "opacity": 0.8
          },
          {
            "id": "meter-cap",
            "type": "rect",
            "frame": {
              "x": {
                "$expr": "((bounds.width - (meter.channelCount * (min(32, (bounds.width - 64) / max(1, meter.channelCount)))) + 40) / 2) + item.index * (min(32, (bounds.width - 64) / max(1, meter.channelCount))) + ((min(32, (bounds.width - 64) / max(1, meter.channelCount))) - 16) / 2"
              },
              "y": {
                "$expr": "84 + (bounds.height - 172) * (1 - clamp((item.peakDb + 60) / 60, 0, 1))"
              },
              "width": 16,
              "height": 2
            },
            "fill": {
              "$ref": "colors.studio.text"
            },
            "visible": {
              "$expr": "item.peakDb > -60"
            }
          },
          {
            "id": "meter-label",
            "type": "text",
            "frame": {
              "x": {
                "$expr": "((bounds.width - (meter.channelCount * (min(32, (bounds.width - 64) / max(1, meter.channelCount)))) + 40) / 2) + item.index * (min(32, (bounds.width - 64) / max(1, meter.channelCount)))"
              },
              "y": {
                "$expr": "bounds.height - 78"
              },
              "width": {
                "$expr": "min(32, (bounds.width - 64) / max(1, meter.channelCount))"
              },
              "height": 24
            },
            "text": {
              "$context": "item.label"
            },
            "font": {
              "$ref": "fonts.workspaceBody"
            },
            "fontSize": {
              "$ref": "metrics.textCaption"
            },
            "color": {
              "$ref": "colors.studio.text"
            },
            "align": "center",
            "maxLines": 1,
            "overflow": "ellipsis"
          }
        ]
      }
    },
    {
      "id": "footer-rule",
      "type": "rect",
      "frame": {
        "x": 0,
        "y": {
          "$expr": "bounds.height - 44"
        },
        "width": {
          "$expr": "bounds.width"
        },
        "height": 1
      },
      "fill": {
