{
  "apiVersion": 1,
  "target": "channelMixer",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.studio.border"
        },
        "width": 0,
        "placement": "inside"
      }
    }
  ],
  "variants": {
    "focused": {
      "body.fill": {
        "$expr": "alpha(token.colors.studio.focus, token.metrics.focusSurfaceOpacity)"
      }
    }
  },
  "rowLayout": {
    "rowHeight": 56,
    "rowGap": 4,
    "slots": {
      "row.source": {
        "x": 0,
        "y": 0,
        "width": 40,
        "height": 24
      },
      "row.peak": {
        "x": 40,
        "y": 0,
        "width": {
          "$expr": "max(0,bounds.width - 104)"
        },
        "height": 24
      },
      "row.destination": {
        "x": {
          "$expr": "bounds.width - 60"
        },
        "y": 0,
        "width": 60,
        "height": 24
      },
      "row.mute": {
        "x": {
          "$expr": "bounds.width - 68"
        },
        "y": 28,
        "width": 32,
        "height": 28
      },
      "row.solo": {
        "x": {
          "$expr": "bounds.width - 32"
        },
        "y": 28,
        "width": 32,
        "height": 28
      },
      "row.gain": {
        "x": 0,
        "y": 28,
        "width": {
          "$expr": "bounds.width - 72"
        },
        "height": 28
      },
      "row.surface": {
        "x": 0,
        "y": 0,
        "width": {
          "$expr": "bounds.width"
        },
        "height": {
          "$expr": "bounds.height"
        }
      }
    },
    "breakpoints": [
      {
        "slots": {
          "row.peak": {
            "x": 0,
            "y": 0,
            "width": 0,
            "height": 0
          }
        },
        "when": {
          "maxWidth": 194
        }
      }
    ]
  },
  "controlStyle": {
    "minItemWidth": 156,
    "itemGap": 16
  }
}
