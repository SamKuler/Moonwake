{
  "apiVersion": 1,
  "root": {
    "id": "effects-root",
    "type": "column",
    "padding": 18,
    "gap": 10,
    "style": "surface.canvas",
    "children": [
      {
        "id": "effects-header",
        "type": "row",
        "height": 40,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "id": "effects-title",
            "type": "component",
            "component": "effects.title",
            "style": "label.title",
            "grow": 1
          }
        ]
      },
      {
        "id": "effects-filter-label",
        "type": "component",
        "component": "effects.filterLabel",
        "style": "label.section",
        "height": 22
      },
      {
        "id": "effects-filter",
        "type": "component",
        "component": "effects.filter",
        "style": "textEditor.default",
        "height": 36,
        "focusOrder": 20
      },
      {
        "id": "effects-insert-row",
        "type": "row",
        "height": 38,
        "gap": 8,
        "children": [
          {
            "id": "effects-catalog",
            "type": "component",
            "component": "effects.catalog",
            "style": "comboBox.default",
            "grow": 1,
            "focusOrder": 30
          },
          {
            "id": "effects-add",
            "type": "component",
            "component": "effects.add",
            "style": "textButton.iconPrimary",
            "width": 36,
            "focusOrder": 40,
            "height": 36,
            "shrink": 0
          }
        ]
      },
      {
        "id": "effects-chain",
        "type": "component",
        "component": "effects.chain",
        "style": "effectChain.default",
        "grow": 1,
        "focusOrder": 50
      }
    ]
  }
}
