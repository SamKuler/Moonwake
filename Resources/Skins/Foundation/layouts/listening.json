{
  "apiVersion": 1,
  "root": {
    "id": "listening-root", "type": "column", "padding": 0, "gap": 0,
    "children": [
      {
        "id": "listening-header", "type": "row", "height": 60, "padding": 12, "gap": 8, "align": "center",
        "children": [
          { "id": "listening-brand", "type": "component", "component": "app.brand.title", "grow": 1 },
          { "id": "listening-studio", "type": "component", "component": "workspace.studio", "width": 108, "height": 36, "focusOrder": 10 },
          { "id": "listening-mode", "type": "component", "component": "workspace.listening", "width": 108, "height": 36, "focusOrder": 20 },
          { "id": "listening-settings", "type": "component", "component": "settings.open", "width": 92, "height": 36, "focusOrder": 30 }
        ]
      },
      {
        "id": "listening-content", "type": "row", "padding": 12, "gap": 12, "grow": 1,
        "children": [
          {
            "id": "listening-art", "type": "column", "width": "38%", "padding": 14, "gap": 8, "style": "surface.default",
            "children": [
              { "id": "listening-cover", "type": "component", "component": "artwork.cover", "grow": 1 },
              { "id": "listening-meta", "type": "component", "component": "artwork.metadata", "height": 24 }
            ]
          },
          {
            "id": "listening-main", "type": "column", "gap": 10, "grow": 1,
            "children": [
              { "id": "listening-now-playing", "type": "component", "component": "nowPlaying.title", "height": 42 },
              { "id": "listening-now-meta", "type": "component", "component": "nowPlaying.metadata", "height": 22 },
              {
                "id": "listening-queue-panel", "type": "column", "padding": 10, "gap": 8, "grow": 1, "style": "surface.default",
                "children": [
                  {
                    "id": "listening-queue-header", "type": "row", "height": 38, "gap": 8, "align": "center",
                    "children": [
                      { "id": "listening-queue-title", "type": "component", "component": "queue.title", "grow": 1 },
                      { "id": "listening-queue-count", "type": "component", "component": "queue.count", "width": 72 },
                      { "id": "listening-add", "type": "component", "component": "library.add", "width": 108, "height": 36, "focusOrder": 40 }
                    ]
                  },
                  { "id": "listening-queue", "type": "component", "component": "queue.table", "grow": 1, "focusOrder": 50 }
                ]
              },
              { "id": "listening-seek", "type": "component", "component": "transport.seek", "presentation": "linearHorizontal", "height": 30, "focusOrder": 90 },
              { "id": "listening-time", "type": "component", "component": "transport.time", "height": 20 },
              {
                "id": "listening-controls", "type": "row", "height": 88, "gap": 8, "align": "center",
                "children": [
                  { "id": "listening-previous", "type": "component", "component": "transport.previous", "width": 64, "height": 44, "focusOrder": 60 },
                  { "id": "listening-play", "type": "component", "component": "transport.playPause", "width": 76, "height": 48, "focusOrder": 70 },
                  { "id": "listening-next", "type": "component", "component": "transport.next", "width": 64, "height": 44, "focusOrder": 80 },
                  { "id": "listening-effects", "type": "component", "component": "effects.open", "width": 88, "height": 40, "focusOrder": 110 },
                  { "id": "listening-spacer", "type": "visual", "style": "surface.default", "grow": 1 },
                  { "id": "listening-volume", "type": "component", "component": "transport.volume", "presentation": "rotary", "width": 88, "height": 88, "focusOrder": 100 }
                ]
              }
            ]
          }
        ]
      },
      { "id": "listening-status", "type": "component", "component": "app.status", "height": 28 }
    ]
  }
}
