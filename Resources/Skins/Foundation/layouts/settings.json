{
  "apiVersion": 1,
  "root": {
    "id": "settings-root",
    "type": "column",
    "padding": {
      "top": 8,
      "right": 18,
      "bottom": 18,
      "left": 18
    },
    "gap": 12,
    "style": "surface.canvas",
    "children": [
      {
        "id": "settings-header",
        "type": "row",
        "height": 44,
        "gap": 10,
        "align": "center",
        "children": [
          {
            "id": "settings-title",
            "type": "component",
            "component": "settings.title",
            "style": "label.title",
            "grow": 1
          }
        ]
      },
      {
        "id": "settings-content",
        "type": "row",
        "gap": 12,
        "grow": 1,
        "children": [
          {
            "id": "settings-audio",
            "type": "column",
            "padding": 16,
            "gap": 8,
            "width": "38%",
            "style": "surface.default",
            "children": [
              {
                "id": "settings-audio-heading",
                "type": "component",
                "component": "settings.audio.heading",
                "style": "label.section",
                "height": 32
              },
              {
                "id": "settings-device",
                "type": "component",
                "component": "settings.audio.device",
                "style": "comboBox.default",
                "height": 36,
                "focusOrder": 20
              },
              {
                "id": "settings-rate",
                "type": "component",
                "component": "settings.audio.sampleRate",
                "style": "comboBox.default",
                "height": 36,
                "focusOrder": 30
              },
              {
                "id": "settings-buffer",
                "type": "component",
                "component": "settings.audio.bufferSize",
                "style": "comboBox.default",
                "height": 36,
                "focusOrder": 40
              },
              {
                "id": "settings-layout",
                "type": "component",
                "component": "settings.audio.channelLayout",
                "style": "comboBox.default",
                "height": 36,
                "focusOrder": 50
              },
              {
                "id": "settings-channel-map",
                "type": "component",
                "component": "settings.audio.channelMap",
                "style": "channelMap.default",
                "grow": 1
              }
            ]
          },
          {
            "id": "settings-right",
            "type": "column",
            "gap": 12,
            "grow": 1,
            "children": [
              {
                "id": "settings-plugins",
                "type": "column",
                "padding": 16,
                "gap": 8,
                "grow": 1,
                "style": "surface.default",
                "children": [
                  {
                    "id": "settings-formats-row",
                    "type": "row",
                    "height": 32,
                    "shrink": 0,
                    "gap": 8,
                    "align": "center",
                    "children": [
                      {
                        "id": "settings-formats",
                        "type": "component",
                        "component": "settings.plugins.formats",
                        "style": "label.section",
                        "grow": 1,
                        "height": 32
                      },
                      {
                        "id": "settings-formats-enableVst3",
                        "type": "component",
                        "component": "settings.plugins.enableVst3",
                        "style": "toggleButton.default",
                        "width": 80,
                        "focusOrder": 180
                      },
                      {
                        "id": "settings-formats-enableAu",
                        "type": "component",
                        "component": "settings.plugins.enableAu",
                        "style": "toggleButton.default",
                        "width": 68,
                        "focusOrder": 182
                      }
                    ]
                  },
                  {
                    "id": "settings-formats-filters",
                    "type": "row",
                    "height": 36,
                    "shrink": 0,
                    "gap": 8,
                    "children": [
                      {
                        "id": "settings-formats-filter",
                        "type": "component",
                        "component": "settings.plugins.filter",
                        "style": "textEditor.default",
                        "grow": 1,
                        "focusOrder": 190
                      },
                      {
                        "id": "settings-formats-typeFilter",
                        "type": "component",
                        "component": "settings.plugins.typeFilter",
                        "style": "comboBox.default",
                        "width": 116,
                        "shrink": 0,
                        "focusOrder": 192
                      },
                      {
                        "id": "settings-formats-manufacturerFilter",
                        "type": "component",
                        "component": "settings.plugins.manufacturerFilter",
                        "style": "comboBox.default",
                        "width": 180,
                        "shrink": 0,
                        "focusOrder": 194
                      },
                      {
                        "id": "settings-formats-formatFilter",
                        "type": "component",
                        "component": "settings.plugins.formatFilter",
                        "style": "comboBox.default",
                        "width": 132,
                        "shrink": 0,
                        "focusOrder": 196
                      }
                    ]
                  },
                  {
                    "id": "settings-known-list",
                    "type": "component",
                    "component": "settings.plugins.knownList",
                    "style": "pluginList.default",
                    "grow": 1,
                    "focusOrder": 200
                  },
                  {
                    "id": "settings-scan-actions",
                    "type": "row",
                    "height": 36,
                    "gap": 8,
                    "children": [
                      {
                        "id": "settings-scan-all",
                        "type": "component",
                        "component": "settings.plugins.scanAll",
                        "style": "textButton.leadingPrimary",
                        "grow": 1,
                        "focusOrder": 210
                      },
                      {
                        "id": "settings-scan-folder",
                        "type": "component",
                        "component": "settings.plugins.scanFolder",
                        "style": "textButton.leadingNeutral",
                        "grow": 1,
                        "focusOrder": 220
                      },
                      {
                        "id": "settings-cancel",
                        "type": "component",
                        "component": "settings.plugins.cancel",
                        "style": "textButton.default",
                        "grow": 1,
                        "focusOrder": 230
                      }
                    ]
                  },
                  {
                    "id": "settings-progress",
                    "type": "component",
                    "component": "settings.plugins.progress",
                    "style": "progressBar.default",
                    "height": 8
                  }
                ]
              },
              {
                "id": "settings-skins",
                "type": "column",
                "padding": 16,
                "gap": 8,
                "height": 264,
                "style": "surface.default",
                "children": [
                  {
                    "id": "settings-skins-heading",
                    "type": "component",
                    "component": "settings.skins.heading",
                    "style": "label.section",
                    "height": 24
                  },
                  {
                    "id": "settings-skin-list",
                    "type": "component",
                    "component": "settings.skins.library",
                    "style": "skinList.default",
                    "height": 112,
                    "focusOrder": 300
                  },
                  {
                    "id": "settings-skin-source-actions",
                    "type": "row",
                    "height": 36,
                    "gap": 8,
                    "children": [
                      {
                        "id": "settings-import",
                        "type": "component",
                        "component": "settings.skins.import",
                        "style": "textButton.leadingNeutral",
                        "grow": 1,
                        "focusOrder": 310
                      },
                      {
                        "id": "settings-reload",
                        "type": "component",
                        "component": "settings.skins.reload",
                        "style": "textButton.leadingNeutral",
                        "grow": 1,
                        "focusOrder": 320
                      },
                      {
                        "id": "settings-remove",
                        "type": "component",
                        "component": "settings.skins.remove",
                        "style": "textButton.leadingNeutral",
                        "grow": 1,
                        "focusOrder": 330
                      }
                    ]
                  },
                  {
                    "id": "settings-skin-commit-actions",
                    "type": "row",
                    "height": 36,
                    "gap": 8,
                    "children": [
                      {
                        "id": "settings-preview",
                        "type": "component",
                        "component": "settings.skins.preview",
                        "style": "textButton.leadingNeutral",
                        "grow": 1,
                        "focusOrder": 340
                      },
                      {
                        "id": "settings-apply",
                        "type": "component",
                        "component": "settings.skins.apply",
                        "style": "textButton.primary",
                        "grow": 1,
                        "focusOrder": 350
                      },
                      {
                        "id": "settings-cancel-preview",
                        "type": "component",
                        "component": "settings.skins.cancelPreview",
                        "style": "textButton.default",
                        "grow": 1,
                        "focusOrder": 360
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      }
    ]
  }
}
