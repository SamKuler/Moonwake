{
  "apiVersion": 1,
  "root": {
    "id": "studio-root",
    "type": "column",
    "padding": {
      "top": 8,
      "right": 0,
      "bottom": 0,
      "left": 0
    },
    "gap": 0,
    "style": "surface.canvas",
    "children": [
      {
        "id": "studio-header",
        "type": "row",
        "height": 60,
        "padding": 12,
        "gap": 8,
        "align": "center",
        "children": [
          {
            "id": "studio-brand",
            "type": "component",
            "component": "app.brand.title",
            "style": "label.title",
            "grow": 1
          },
          {
            "id": "studio-mode",
            "type": "component",
            "component": "workspace.studio",
            "style": "textButton.primary",
            "width": 108,
            "height": 36,
            "focusOrder": 10
          },
          {
            "id": "studio-listening",
            "type": "component",
            "component": "workspace.listening",
            "style": "textButton.default",
            "width": 108,
            "height": 36,
            "focusOrder": 20
          },
          {
            "id": "studio-settings",
            "type": "component",
            "component": "settings.open",
            "style": "textButton.iconNeutral",
            "width": 44,
            "height": 36,
            "focusOrder": 30
          }
        ]
      },
      {
        "id": "studio-content",
        "type": "row",
        "padding": 12,
        "gap": 12,
        "grow": 1,
        "children": [
          {
            "id": "studio-library",
            "type": "column",
            "width": "46%",
            "padding": 10,
            "gap": 8,
            "style": "surface.default",
            "children": [
              {
                "id": "studio-queue-header",
                "type": "row",
                "height": 38,
                "gap": 8,
                "align": "center",
                "children": [
                  {
                    "id": "studio-queue-title",
                    "type": "component",
                    "component": "queue.title",
                    "grow": 1
                  },
                  {
                    "id": "studio-queue-count",
                    "type": "component",
                    "component": "queue.count",
                    "width": 72
                  },
                  {
                    "id": "studio-add",
                    "type": "component",
                    "component": "library.add",
                    "style": "textButton.iconPrimary",
                    "width": 44,
                    "height": 36,
                    "focusOrder": 40
                  }
                ]
              },
              {
                "id": "studio-library-search",
                "type": "component",
                "component": "library.search",
                "height": 34,
                "focusOrder": 45
              },
              {
                "id": "studio-queue-stack",
                "type": "stack",
                "grow": 1,
                "children": [
                  {
                    "id": "studio-queue",
                    "type": "component",
                    "component": "queue.table",
                    "anchors": {
                      "top": 0,
                      "right": 0,
                      "bottom": 0,
                      "left": 0
                    },
                    "focusOrder": 50
                  },
                  {
                    "id": "studio-queue-empty",
                    "type": "component",
                    "component": "queue.empty",
                    "anchors": {
                      "top": 0,
                      "right": 0,
                      "bottom": 0,
                      "left": 0
                    }
                  }
                ]
              }
            ]
          },
          {
            "id": "studio-transport",
            "type": "column",
            "gap": 10,
            "padding": 14,
            "grow": 1,
            "style": "surface.default",
            "children": [
              {
                "id": "studio-title-row",
                "type": "row",
                "height": 40,
                "gap": 8,
                "align": "center",
                "children": [
                  {
                    "id": "studio-title",
                    "type": "component",
                    "component": "nowPlaying.title",
                    "style": "label.title",
                    "grow": 1
                  },
                  {
                    "id": "studio-effects",
                    "type": "component",
                    "component": "effects.open",
                    "style": "textButton.iconNeutral",
                    "width": 44,
                    "height": 36,
                    "focusOrder": 110
                  }
                ]
              },
              {
                "id": "studio-seek",
                "type": "component",
                "component": "transport.seek",
                "presentation": "linearHorizontal",
                "height": 32,
                "focusOrder": 90
              },
              {
                "id": "studio-time",
                "type": "component",
                "component": "transport.time",
                "height": 22
              },
              {
                "id": "studio-controls",
                "type": "row",
                "height": 48,
                "gap": 8,
                "children": [
                  {
                    "id": "studio-previous",
                    "type": "component",
                    "component": "transport.previous",
                    "style": "textButton.iconNeutral",
                    "width": 48,
                    "focusOrder": 60
                  },
                  {
                    "id": "studio-play",
                    "type": "component",
                    "component": "transport.playPause",
                    "style": "textButton.iconPrimary",
                    "width": 56,
                    "focusOrder": 70
                  },
                  {
                    "id": "studio-next",
                    "type": "component",
                    "component": "transport.next",
                    "style": "textButton.iconNeutral",
                    "width": 48,
                    "focusOrder": 80
                  }
                ]
              },
              {
                "id": "studio-volume",
                "type": "component",
                "component": "transport.volume",
                "presentation": "linearHorizontal",
                "height": 34,
                "focusOrder": 100
              },
              {
                "id": "studio-output",
                "type": "component",
                "component": "output.stage",
                "grow": 1
              }
            ]
          }
        ]
      },
      {
        "id": "studio-status",
        "type": "component",
        "component": "app.status",
        "height": 28
      }
    ]
  }
}
