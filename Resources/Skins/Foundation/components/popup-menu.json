{
  "apiVersion": 1, "target": "popupMenu",
  "layers": [
    { "id": "body", "type": "roundedRect", "frame": { "anchor": "bounds", "inset": 0.5 }, "radius": { "$ref": "metrics.radius" }, "fill": { "$ref": "colors.surfaceRaised" }, "stroke": { "color": { "$ref": "colors.border" }, "width": 1 } },
    { "id": "label", "type": "text", "frame": { "anchor": "contentBounds", "inset": 8 }, "text": { "$context": "text.primary" }, "font": { "$ref": "fonts.body" }, "fontSize": 13, "color": { "$ref": "colors.text" }, "align": "left", "maxLines": 1, "overflow": "ellipsis" }
  ],
  "variants": { "selected": { "body.fill": { "$ref": "colors.controlActive" } }, "hover": { "body.opacity": 0.9 }, "disabled": { "label.opacity": 0.45 } }
}
