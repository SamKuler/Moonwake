{
  "apiVersion": 1,
  "target": "linearSlider",
  "layers": [
    {
      "id": "track",
      "type": "roundedRect",
      "frame": {
        "x": 4,
        "y": {
          "$expr": "bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "bounds.width - 8"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.track"
      }
    },
    {
      "id": "value",
      "type": "roundedRect",
      "frame": {
        "x": 4,
        "y": {
          "$expr": "bounds.height * 0.5 - 2"
        },
        "width": {
          "$expr": "(bounds.width - 8) * value.normalized"
        },
        "height": 4
      },
      "radius": 2,
      "fill": {
        "$ref": "colors.controlActive"
      }
    },
    {
      "id": "thumb",
      "type": "ellipse",
      "frame": {
        "x": {
          "$expr": "bounds.x + 1 + (bounds.width - 8) * value.normalized"
        },
        "y": {
          "$expr": "bounds.y + bounds.height * 0.5 - 3"
        },
        "width": 6,
        "height": 6
      },
      "fill": {
        "$ref": "colors.controlActive"
      }
    }
  ],
  "variants": {
    "disabled": {
      "track.opacity": 0.4,
      "value.opacity": 0.4,
      "thumb.opacity": 0.4
    },
    "focused": {
      "thumb.frame.width": 8,
      "thumb.frame.height": 8,
      "thumb.frame.x": {
        "$expr": "bounds.x + (bounds.width - 8) * value.normalized"
      },
      "thumb.frame.y": {
        "$expr": "bounds.y + bounds.height * 0.5 - 4"
      }
    }
  },
  "controlStyle": {
    "trackBounds": {
      "x": 4,
      "y": {
        "$expr": "bounds.height * 0.5 - 2"
      },
      "width": {
        "$expr": "max(0, bounds.width - 8)"
      },
      "height": 4
    },
    "thumbRadius": 4
  }
}
