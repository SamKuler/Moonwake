{
  "apiVersion": 1, "target": "label",
  "layers": [
    { "id": "pill", "type": "roundedRect", "frame": { "anchor": "bounds", "inset": 1 }, "radius": 7, "fill": { "$ref": "colors.control" } },
    { "id": "active-pill", "type": "roundedRect", "visible": { "$context": "skin.active" }, "frame": { "anchor": "bounds", "inset": 1 }, "radius": 7, "fill": { "$ref": "colors.controlActive" } },
    { "id": "label", "type": "text", "visible": { "$expr": "not skin.active" }, "frame": { "anchor": "contentBounds", "inset": { "left": 8, "right": 8 } }, "text": { "$context": "text.primary" }, "font": { "$ref": "fonts.data" }, "fontSize": 10.5, "color": { "$ref": "colors.textMuted" }, "align": "center", "maxLines": 1, "overflow": "ellipsis" },
    { "id": "active-label", "type": "text", "visible": { "$context": "skin.active" }, "frame": { "anchor": "contentBounds", "inset": { "left": 8, "right": 8 } }, "text": { "$context": "text.primary" }, "font": { "$ref": "fonts.data" }, "fontSize": 10.5, "color": { "$ref": "colors.background" }, "align": "center", "maxLines": 1, "overflow": "ellipsis" }
  ]
}
