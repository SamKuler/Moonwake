{
  "label": {
    "default": "components/label.json",
    "title": "components/title-label.json",
    "section": "components/section-label.json",
    "muted": "components/muted-label.json",
    "data": "components/data-label.json",
    "skinStatus": "components/skin-status.json"
  },
  "textButton": {
    "default": "components/text-button.json",
    "primary": "components/primary-button.json",
    "iconNeutral": {
      "renderer": "components/icon-button.json",
      "slots": {
        "icon.add": "surface.icon", "icon.settings": "surface.icon", "icon.effects": "surface.icon", "icon.close": "surface.icon",
        "icon.previous": "surface.icon", "icon.play": "surface.icon", "icon.pause": "surface.icon", "icon.next": "surface.icon",
        "icon.remove": "surface.icon", "icon.moveUp": "surface.icon", "icon.moveDown": "surface.icon", "icon.scan": "surface.icon",
        "icon.folderSearch": "surface.icon", "icon.import": "surface.icon", "icon.reload": "surface.icon", "icon.preview": "surface.icon"
      }
    },
    "iconPrimary": {
      "renderer": "components/primary-icon-button.json",
      "slots": {
        "icon.add": "surface.onPrimaryIcon", "icon.settings": "surface.onPrimaryIcon", "icon.effects": "surface.onPrimaryIcon", "icon.close": "surface.onPrimaryIcon",
        "icon.previous": "surface.onPrimaryIcon", "icon.play": "surface.onPrimaryIcon", "icon.pause": "surface.onPrimaryIcon", "icon.next": "surface.onPrimaryIcon",
        "icon.remove": "surface.onPrimaryIcon", "icon.moveUp": "surface.onPrimaryIcon", "icon.moveDown": "surface.onPrimaryIcon", "icon.scan": "surface.onPrimaryIcon",
        "icon.folderSearch": "surface.onPrimaryIcon", "icon.import": "surface.onPrimaryIcon", "icon.reload": "surface.onPrimaryIcon", "icon.preview": "surface.onPrimaryIcon"
      }
    },
    "leadingNeutral": {
      "renderer": "components/leading-button.json",
      "slots": {
        "icon.add": "surface.icon", "icon.settings": "surface.icon", "icon.effects": "surface.icon", "icon.close": "surface.icon",
        "icon.previous": "surface.icon", "icon.play": "surface.icon", "icon.pause": "surface.icon", "icon.next": "surface.icon",
        "icon.remove": "surface.icon", "icon.moveUp": "surface.icon", "icon.moveDown": "surface.icon", "icon.scan": "surface.icon",
        "icon.folderSearch": "surface.icon", "icon.import": "surface.icon", "icon.reload": "surface.icon", "icon.preview": "surface.icon"
      }
    },
    "leadingPrimary": {
      "renderer": "components/primary-leading-button.json",
      "slots": {
        "icon.add": "surface.onPrimaryIcon", "icon.settings": "surface.onPrimaryIcon", "icon.effects": "surface.onPrimaryIcon", "icon.close": "surface.onPrimaryIcon",
        "icon.previous": "surface.onPrimaryIcon", "icon.play": "surface.onPrimaryIcon", "icon.pause": "surface.onPrimaryIcon", "icon.next": "surface.onPrimaryIcon",
        "icon.remove": "surface.onPrimaryIcon", "icon.moveUp": "surface.onPrimaryIcon", "icon.moveDown": "surface.onPrimaryIcon", "icon.scan": "surface.onPrimaryIcon",
        "icon.folderSearch": "surface.onPrimaryIcon", "icon.import": "surface.onPrimaryIcon", "icon.reload": "surface.onPrimaryIcon", "icon.preview": "surface.onPrimaryIcon"
      }
    }
  },
  "toggleButton": { "default": "components/toggle-button.json" },
  "comboBox": { "default": "components/combo-box.json" },
  "textEditor": { "default": "components/text-editor.json" },
  "linearSlider": { "default": "components/linear-slider.json" },
  "rotarySlider": { "default": "components/rotary-slider.json" },
  "progressBar": { "default": "components/progress-bar.json" },
  "scrollBar": { "default": "components/scroll-bar.json" },
  "popupMenu": { "default": "components/popup-menu.json" },
  "tooltip": { "default": "components/tooltip.json" },
  "table": {
    "default": {
      "renderer": "components/table.json",
      "slots": {
        "header.surface": "surface.listRow",
        "header.text": "label.default",
        "row.surface": "surface.listRow",
        "cell.title": "label.default",
        "cell.location": "label.default",
        "cell.duration": "label.default"
      }
    }
  },
  "surface": {
    "default": "components/surface.json",
    "canvas": "components/canvas.json",
    "listRow": "components/list-row.json",
    "skinRow": "components/skin-row.json",
    "icon": "components/icon.json",
    "onPrimaryIcon": "components/on-primary-icon.json",
    "artworkOverlay": "components/artwork-overlay.json"
  },
  "artwork": {
    "default": {
      "renderer": "components/artwork.json",
      "slots": {
        "frame.background": "surface.default",
        "frame.overlay": "surface.artworkOverlay"
      }
    },
    "assetProbe": "components/artwork-asset-probe.json"
  },
  "effectChain": {
    "default": {
      "renderer": "components/effect-chain.json",
      "slots": {
        "slot.surface": "surface.default",
        "slot.name": "label.default",
        "slot.bypass": "textButton.default",
        "slot.editor": "textButton.default",
        "slot.remove": "textButton.default",
        "slot.dragIndicator": "surface.default"
      }
    }
  },
  "outputStage": { "default": "components/output-stage.json" },
  "channelMap": {
    "default": {
      "renderer": "components/channel-map.json",
      "slots": {
        "row.surface": "surface.listRow",
        "row.source": "label.data",
        "row.destination": "label.muted"
      }
    }
  },
  "pluginList": {
    "default": {
      "renderer": "components/plugin-list.json",
      "slots": {
        "row.surface": "surface.listRow",
        "row.name": "label.default",
        "row.manufacturer": "label.muted",
        "row.format": "label.data",
        "row.status": "label.muted"
      }
    }
  },
  "skinList": {
    "default": {
      "renderer": "components/skin-list.json",
      "slots": {
        "row.surface": "surface.skinRow",
        "row.name": "label.default",
        "row.author": "label.muted",
        "row.version": "label.data",
        "row.status": "label.skinStatus"
      }
    }
  }
}
