        "calibration.signalLabel": "label.muted",
        "calibration.signal": "comboBox.default",
        "calibration.levelLabel": "label.muted",
        "calibration.level": "textEditor.default",
        "calibration.frequencyLabel": "label.muted",
        "calibration.frequency": "textEditor.default",
