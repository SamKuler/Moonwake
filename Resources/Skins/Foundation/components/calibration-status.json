{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds"
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.body"
      },
      "fontSize": 12,
      "color": {
        "$ref": "colors.textMuted"
      },
      "align": {
        "$context": "text.align"
      },
      "maxLines": 2,
      "overflow": "ellipsis"
    }
  ]
}
