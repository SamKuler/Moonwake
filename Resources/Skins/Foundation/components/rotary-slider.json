{
  "apiVersion": 1,
  "target": "rotarySlider",
  "layers": [
    {
      "id": "dial",
      "type": "ellipse",
      "frame": {
        "anchor": "bounds",
        "inset": 6
      },
      "fill": {
        "$ref": "colors.control"
      },
      "stroke": {
        "color": {
          "$ref": "colors.border"
        },
        "width": 1
      }
    },
    {
      "id": "arc",
      "type": "arc",
      "center": {
        "x": {
          "$expr": "bounds.width * 0.5"
        },
        "y": {
          "$expr": "bounds.height * 0.5"
        }
      },
      "radiusX": {
        "$expr": "min(bounds.width, bounds.height) * 0.42"
      },
      "radiusY": {
        "$expr": "min(bounds.width, bounds.height) * 0.42"
      },
      "startAngle": 135,
      "endAngle": {
        "$expr": "135 + value.normalized * 270"
      },
      "stroke": {
        "color": {
          "$ref": "colors.controlActive"
        },
        "width": 3,
        "cap": "round"
      }
    }
  ],
  "variants": {
    "disabled": {
      "dial.opacity": 0.4,
      "arc.opacity": 0.4
    },
    "focused": {
      "dial.fill": {
        "$expr": "mix(token.colors.control, token.colors.focus, token.metrics.focusOverlayOpacity)"
      }
    }
  },
  "controlStyle": {
    "trackBounds": {
      "x": 6,
      "y": 6,
      "width": {
        "$expr": "max(0, bounds.width - 12)"
      },
      "height": {
        "$expr": "max(0, bounds.height - 12)"
      }
    },
    "thumbRadius": 4
  }
}
