{
  "apiVersion": 1,
  "target": "toggleButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": 10,
      "fill": {
        "$ref": "colors.control"
      },
      "stroke": {
        "color": "#00000000",
        "width": 0
      },
      "visible": {
        "$expr": "state.selected or state.hover or state.pressed"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": 10,
      "fill": {
        "$expr": "alpha(token.colors.focus, token.metrics.focusOverlayOpacity)"
      }
    },
    {
      "id": "shuffle",
      "type": "path",
      "data": "M3 7 L6 7 C10 7 14 17 18 17 L21 17 M18 14 L21 17 L18 20 M3 17 L6 17 C10 17 14 7 18 7 L21 7 M18 4 L21 7 L18 10",
      "fill": "#00000000",
      "stroke": {
        "color": {
          "$ref": "colors.text"
        },
        "width": 2.4,
        "cap": "round"
      },
      "transform": {
        "pivotX": 0,
        "pivotY": 0,
        "scaleX": 0.8333333333333334,
        "scaleY": 0.8333333333333334,
        "translateX": {
          "$expr": "(bounds.width - 20) * 0.5"
        },
        "translateY": {
          "$expr": "(bounds.height - 20) * 0.5"
        }
      }
    }
  ],
  "variants": {
    "selected": {
      "body.fill": {
        "$ref": "colors.controlActive"
      },
      "shuffle.stroke.color": {
        "$ref": "colors.background"
      },
      "focus.fill": {
        "$expr": "alpha(token.colors.background, token.metrics.focusOverlayOpacity)"
      }
    },
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.76
    },
    "disabled": {
      "body.opacity": 0.4,
      "shuffle.opacity": 0.4
    }
  },
  "transitions": {
    "hover": {
      "durationMs": {
        "$ref": "durations.fast"
      },
      "easing": "easeOut",
      "properties": [
        "body.opacity"
      ]
    }
  }
}
