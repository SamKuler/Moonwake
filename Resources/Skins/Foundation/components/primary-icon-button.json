{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": {
        "$ref": "colors.controlActive"
      },
      "stroke": {
        "color": {
          "$ref": "colors.controlActive"
        },
        "width": 1,
        "placement": "inside"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": {
        "$expr": "alpha(token.colors.background, token.metrics.focusOverlayOpacity)"
      }
    }
  ],
  "variants": {
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.76
    },
    "disabled": {
      "body.opacity": 0.4
    }
  },
  "controlStyle": {
    "iconBounds": {
      "x": {
        "$expr": "(bounds.width - 20) * 0.5"
      },
      "y": {
        "$expr": "(bounds.height - 20) * 0.5"
      },
      "width": 20,
      "height": 20
    }
  }
}
