{
  "apiVersion": 1, "target": "toggleButton",
  "layers": [
    { "id": "body", "type": "roundedRect", "frame": { "anchor": "bounds", "inset": 0.5 }, "radius": { "$ref": "metrics.radius" }, "fill": { "$ref": "colors.control" }, "stroke": { "color": { "$ref": "colors.border" }, "width": 1 } },
    { "id": "label", "type": "text", "frame": { "anchor": "contentBounds", "inset": 6 }, "text": { "$context": "text.primary" }, "font": { "$ref": "fonts.body" }, "fontSize": 13, "color": { "$ref": "colors.text" }, "align": "center", "maxLines": 1 },
    { "id": "focus", "type": "roundedRect", "visible": { "$context": "state.focused" }, "frame": { "anchor": "bounds", "inset": 1.5 }, "radius": { "$ref": "metrics.radius" }, "fill": { "$ref": "colors.transparent" }, "stroke": { "color": { "$ref": "colors.focus" }, "width": 2 } }
  ],
  "variants": { "selected": { "body.fill": { "$ref": "colors.controlActive" } }, "hover": { "body.opacity": 0.9 }, "pressed": { "body.opacity": 0.75 }, "disabled": { "body.opacity": 0.4, "label.opacity": 0.55 } }
}
