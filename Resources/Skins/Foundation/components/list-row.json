{
  "apiVersion": 1, "target": "surface",
  "layers": [
    { "id": "selection", "type": "rect", "visible": { "$context": "state.selected" }, "frame": { "anchor": "bounds" }, "fill": "#D697621C" },
    { "id": "divider", "type": "rect", "frame": { "x": 12, "y": { "$expr": "bounds.height - 1" }, "width": { "$expr": "max(0, bounds.width - 24)" }, "height": 1 }, "fill": { "$ref": "colors.border" } }
  ],
  "variants": { "focused": { "selection.fill": "#D6976230" } }
}
