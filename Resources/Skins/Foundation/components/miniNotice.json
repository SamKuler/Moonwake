{
  "apiVersion": 1,
  "target": "label",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 1
      },
      "radius": 8,
      "fill": {
        "$ref": "colors.surface"
      },
      "stroke": {
        "color": {
          "$ref": "colors.border"
        },
        "width": 1
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": {
          "left": 12,
          "right": 12,
          "top": 8,
          "bottom": 8
        }
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.body"
      },
      "fontSize": 14,
      "color": {
        "$ref": "colors.text"
      },
      "align": "left",
      "maxLines": 2,
      "overflow": "ellipsis"
    }
  ]
}
