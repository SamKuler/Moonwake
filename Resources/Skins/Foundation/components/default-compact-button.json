{
  "apiVersion": 1,
  "target": "textButton",
  "layers": [
    {
      "id": "body",
      "type": "roundedRect",
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": {
        "$ref": "colors.control"
      },
      "stroke": {
        "color": {
          "$ref": "colors.border"
        },
        "width": 1,
        "placement": "inside"
      }
    },
    {
      "id": "focus",
      "type": "roundedRect",
      "visible": {
        "$context": "state.focused"
      },
      "frame": {
        "anchor": "bounds",
        "inset": 0.5
      },
      "radius": {
        "$ref": "metrics.radius"
      },
      "fill": {
        "$expr": "alpha(token.colors.focus, token.metrics.focusOverlayOpacity)"
      }
    },
    {
      "id": "label",
      "type": "text",
      "frame": {
        "anchor": "contentBounds",
        "inset": 2
      },
      "text": {
        "$context": "text.primary"
      },
      "font": {
        "$ref": "fonts.body"
      },
      "fontSize": 13,
      "color": {
        "$ref": "colors.text"
      },
      "align": "center",
      "maxLines": 1,
      "overflow": "ellipsis"
    }
  ],
  "variants": {
    "hover": {
      "body.opacity": 0.9
    },
    "pressed": {
      "body.opacity": 0.75,
      "label.transform.translateY": 1
    },
    "selected": {
      "body.fill": {
        "$ref": "colors.controlActive"
      },
      "focus.fill": {
        "$expr": "alpha(token.colors.background, token.metrics.focusOverlayOpacity)"
      }
    },
    "disabled": {
      "body.opacity": 0.4,
      "label.opacity": 0.55
    }
  },
  "transitions": {
    "hover": {
      "durationMs": {
        "$ref": "durations.fast"
      },
      "easing": "easeOut",
      "properties": [
        "body.opacity"
      ]
    }
  },
  "controlStyle": {
    "iconBounds": {
      "x": {
        "$expr": "(bounds.width - 18) * 0.5"
      },
      "y": {
        "$expr": "(bounds.height - 18) * 0.5"
      },
      "width": 18,
      "height": 18
    }
  }
}
