    "text": { "$context": "text.primary" }, "font": { "$ref": "fonts.body" },
    "fontSize": 13, "color": { "$ref": "colors.text" },
    "align": { "$context": "text.align" },
    "maxLines": 2, "overflow": "ellipsis"
  }]
}
